<?xml version="1.0"?>
<model>
  <name>BlueBoat Tracked (static)</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Rhys Mainwaring</name>
    <email>rhys.mainwaring@me.com</email>
  </author>
  <description>
    Decorative, forced-static copy of blueboat/model.sdf.tracked (this
    project's own retractable-cave-floor-track BlueBoat variant) with all
    control-stack plugins (ros2_control, gz_ros2_control, ArduPilotPlugin,
    TrackController, TrackedVehicle, DetachableJoint, JointStatePublisher,
    OdometryPublisher) stripped and both track-retract joints set to
    initial_position=1.4 (retracted) -- real request: a stationary scene
    prop, not a drivable vehicle. The original, fully-functional
    model.sdf.tracked (spawned via gazebo_tracked_vehicle.launch.py's own
    -file + template-substitution mechanism, not through this
    model.config) is untouched -- see that file's own header comment.
  </description>
</model>
