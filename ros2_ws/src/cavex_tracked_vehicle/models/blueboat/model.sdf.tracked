    </link>
    <!-- motor_stbd_visual / motor_port_visual (real motor housing meshes) removed here:
         tracked variant has no props/motors, replaced below by track assemblies. -->

    <!-- motor_stbd_link / motor_port_link / motor_*_joint (real prop-driven motor assemblies)
         removed here: tracked variant does not drive props. Replaced with two retractable
         track assemblies mounted at the same points the real motors used to occupy
         (-0.488 -0.295 -0.272 / -0.488 0.295 -0.272), per this project's own design pass
         (box-primitive track geometry -- the real BlueBoat has no track hardware, so there
         is no real mesh/CAD to vendor for these parts). -->

    <!-- Deployment struts (real request: keep the tracks clear of the
         hull's own solid collision when deployed): each track no longer
         hangs directly off its retract_mount pivot at a bare -Z offset --
         a real, visible strut link now carries it, and the strut's own
         fixed-joint pose to the track adds a real +0.03m OUTBOARD offset
         (in local y, away from the hull centerline) on top of the
         original -0.15m drop. base_link's own hull collision occupies its
         real bounding box down to z=-0.376 (per the mount-height
         derivation comment elsewhere in this file) and, per this same
         session's real, live-tested finding while investigating a
         separate ROV-cradle collision bug, that collision is genuinely
         SOLID through its whole z-range, not a hollow shell -- so the
         track's own real clearance margin from the hull's side (mount
         y=0.35 vs. the hull's own y=0.45 half-width, only 0.10m) was
         real, not comfortable. The strut's outward push widens that
         margin at every retract angle, deployed or not.
         tracks_separation (below, in the TrackedVehicle plugin) is
         updated from 0.7 to 0.76 to match this new real geometry
         (0.35+0.03=0.38 per side) -- a plugin parameter this project has
         previously left silently mismatched from the real geometry it
         claims to describe would be a real accuracy bug in the skid-steer
         kinematics, not just cosmetic. -->
    <link name="left_track_retract_mount">
      <pose>-0.05 0.35 -0.2 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <joint name="left_track_retract_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_track_retract_mount</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>1.4</upper>
          <effort>50</effort>
          <velocity>1.0</velocity>
        </limit>
      </axis>
    </joint>
    <link name="left_track_strut">
      <pose relative_to="left_track_retract_mount">0 0.015 -0.075 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz></inertia>
      </inertial>
      <visual name="left_track_strut_visual">
        <geometry><box><size>0.08 0.03 0.15</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
      <collision name="left_track_strut_collision">
        <geometry><box><size>0.08 0.03 0.15</size></box></geometry>
      </collision>
    </link>
    <joint name="left_track_strut_fixed" type="fixed">
      <parent>left_track_retract_mount</parent>
      <child>left_track_strut</child>
    </joint>
    <link name="left_track">
      <pose relative_to="left_track_retract_mount">0 0.03 -0.15 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.05</iyy>
          <izz>0.05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="col">
        <geometry>
          <box>
            <size>0.6 0.12 0.15</size>
          </box>
        </geometry>
        <!-- REAL BUG FOUND AND FIXED: this box had zero <surface><friction>
             at all (isotropic gz-sim/DART default), despite gz-sim's own
             reference example (worlds/tracked_vehicle_simple.sdf,
             gz-sim8) requiring anisotropic friction (fdir1 + mu/mu2) on
             every track collision for the TrackedVehicle system's belt
             simulation to convert commanded track speed into correct real
             motion. Without it, commanded forward motion produced mostly
             LATERAL real motion (measured live at 71-92deg off-axis,
             matching this file's own previously-documented "KNOWN OPEN
             ISSUE" on the ArduPilotPlugin block above -- same bug,
             different investigation). fdir1="0 1 0" (Y = across-track/
             skid axis, moderate mu) matches the reference exactly --
             this box is already unrotated with its long (along-track/
             propulsion) axis on local +X, matching TrackController's own
             track_orientation "1 0 0" below, so no rotation-compensation
             was needed unlike the reference's own rotated collision pose.
             CONFIRMED LIVE (fixed): direction went from 71-92deg off-axis
             to ~6-11deg off-axis, i.e. genuinely forward now.

             mu2=150 (the reference's own value) initially caused real,
             measured RTF collapse (0.6+ -> ~0.09) and near-zero real
             displacement on THIS world's dense, irregular cave-floor
             mesh -- the reference world's ground is a flat <plane>,
             and box-vs-uneven-mesh contact at high friction is a known
             ODE solver stiffness source independent of box length
             (confirmed: splitting this box into 3 segments matching the
             reference's own left/right_track_collision/_collision_1/
             _collision_2 structure did NOT help, RTF still collapsed --
             reverted, not worth the complexity). Real fix: raised
             cavex_world.world's ODE solver iterations 50 (gz-sim
             default) -> 200 (see that file's own <physics><ode><solver>
             comment) -- CONFIRMED LIVE this restores full stability at
             mu2=150 (RTF held ~0.6-0.7 under sustained driving, same as
             mu2=5/50, no collapse at any of the three).

             REAL ROOT CAUSE of the "speed identical across mu2=5/50/150"
             finding (found while testing mu2=300): every one of those
             "gz-transport bypass" tests was silently confounded --
             gazebo_tracked_vehicle.launch.py's own track_cmd_vel_bridge.py
             (part of the real ArduPilot control path) was STILL RUNNING
             during every "bypass" test and continuously republishing
             ArduPilot's own near-idle reported velocity onto the exact
             same gz-transport /model/.../cmd_vel topic the bypass test
             was ALSO manually publishing to -- two competing publishers
             on one topic, with the bridge's tiny value dominating.
             CONFIRMED: killing track_cmd_vel_bridge.py before testing
             (genuine isolation) at mu2=300 -- track_cmd_vel reported
             EXACTLY the commanded 1.0 (was 0.02-0.03 before, regardless
             of command magnitude), and real displacement was 4.91m over
             a 10s wall-clock test (~0.98 m/s sim-time-normalized at
             RTF~0.5) -- i.e. essentially the FULL commanded speed, with
             correct direction. Friction/contact physics were NEVER the
             real speed bottleneck at any mu2 tested -- the entire
             "~3-4% of commanded" finding above was a test-methodology
             artifact, not a real physics limitation. mu2=300 confirmed
             genuinely correct and performant; kept as the tuned value.
             The REAL remaining gap for driving via the actual ArduPilot
             path (not this bypass) is ArduPilot's own Rover GUIDED-mode
             velocity-control tuning (CRUISE_SPEED/CRUISE_THROTTLE/
             ATC_SPEED_P in rover.parm) -- a completely different
             subsystem, not gz-sim physics at all. -->
        <surface>
          <friction>
            <ode>
              <mu>0.7</mu>
              <mu2>300</mu2>
              <fdir1>0 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="vis">
        <geometry>
          <box>
            <size>0.6 0.12 0.15</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <!-- Improved track model (real request): idler-wheel end caps,
           visual only -- the functional collision stays the simple box
           above (this project's own established, deliberate choice for
           parts with no real hardware to model against, see the
           box-primitive comment above this whole assembly). Purely
           cosmetic, makes the silhouette read as a track instead of a
           plain plank. -->
      <!-- Fore wheel re-labeled "sprocket" (real request: visible sprocket/roller
           detail) -- same idler-wheel cylinder as before, now with 6 small radial
           tooth nubs added around its rim to read as a drive sprocket rather than
           a plain roller. Aft wheel stays a plain idler wheel, unchanged. -->
      <visual name="left_track_sprocket_fore_visual">
        <pose>0.28 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.075</radius><length>0.13</length></cylinder></geometry>
