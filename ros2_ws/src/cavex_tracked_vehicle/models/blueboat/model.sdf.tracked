<!-- CaveX-Explorer-Pro: BlueBoat tracked-vehicle variant.
     Derived from ArduPilot's real vendored `blueboat` Gazebo model (author Rhys Mainwaring,
     meshes sourced from Blue Robotics' published CAD). This is NOT an official Blue Robotics
     tracked-vehicle product -- it is this project's own modification, replacing the boat's
     motor/prop assemblies with retractable track assemblies for cave-floor locomotion.
     Resolved (was an open TODO through Task 4): gazebo_tracked_vehicle.launch.py spawns this
     file directly via a launch-time `-file` path (a generated/templated copy, see that launch
     file's own comments), not through model.config -- model.config's own model.sdf reference
     stays pointed at the untouched vendored original on purpose, since that's a separate,
     independently-spawnable asset this project doesn't modify. -->
<sdf version="1.9">
  <model name="cavex_tracked_blueboat">
    <link name="base_link">
      <inertial>
        <!-- Re-derived via the parallel-axis theorem after removing the motor/prop assemblies
             (~0.4kg total) and grafting on two 1.5kg retractable track assemblies.

             STEP 1 -- true combined CoM (weighted average of component CoMs, not the old
             hull-only CoM):
               hull:        29.6 kg @ (-0.05,  0,     -0.15)
               left_track:   1.5 kg @ (-0.05,  0.35,  -0.35)
               right_track:  1.5 kg @ (-0.05, -0.35,  -0.35)
               total mass = 32.6 kg
               x_com = -0.05 (all components share x=-0.05)
               y_com = (29.6*0 + 1.5*0.35 + 1.5*(-0.35)) / 32.6 = 0  (left/right cancel)
               z_com = (29.6*(-0.15) + 1.5*(-0.35) + 1.5*(-0.35)) / 32.6
                     = (-4.44 - 0.525 - 0.525) / 32.6 = -5.49 / 32.6 = -0.168405
             -> new combined CoM: (-0.05, 0, -0.168405), an 0.0184m / ~12% shift from the old
                -0.15 hull-only pose declared here previously.

             STEP 2 -- parallel-axis theorem about this NEW combined CoM (not the old one).
             Shift hull by d_hull = new_com - hull_com = (0, 0, -0.018405):
               dIxx_hull = 29.6*(0^2 + 0.018405^2) = 29.6*0.00033874 = 0.010027
               dIyy_hull = 29.6*(0^2 + 0.018405^2) = 0.010027
               dIzz_hull = 29.6*(0^2 + 0^2)         = 0
               ixx_hull' = 2.42369  + 0.010027 = 2.433717
               iyy_hull' = 3.9235025 + 0.010027 = 3.933530
               izz_hull' = 5.6403125 + 0        = 5.640313
             Shift each track (own local inertia ixx=0.02/iyy=0.05/izz=0.05 from the track link
             below) by d_track = new_com - track_com = (0, +/-0.35, +0.181595):
               dIxx_track = 1.5*(0.35^2 + 0.181595^2) = 1.5*(0.1225+0.032977) = 0.233215
               dIyy_track = 1.5*(0^2    + 0.181595^2) = 1.5*0.032977          = 0.049465
               dIzz_track = 1.5*(0^2    + 0.35^2)     = 1.5*0.1225            = 0.18375
               ixx_track' = 0.02 + 0.233215 = 0.253215  (x2 tracks = 0.506430)
               iyy_track' = 0.05 + 0.049465 = 0.099465  (x2 tracks = 0.198930)
               izz_track' = 0.05 + 0.18375  = 0.23375   (x2 tracks = 0.4675)
             Sum (hull' + left_track' + right_track'):
               ixx: 2.433717 + 0.506430 = 2.940147
               iyy: 3.933530 + 0.198930 = 4.132460
               izz: 5.640313 + 0.467500 = 6.107813
             Off-diagonal terms stay 0: x is uniform across all components, and the left/right
             track y-offsets are equal and opposite so any xy/yz cross terms cancel.
             mass: 29.6 (hull, motors/props removed) + 2*1.5 (tracks) = 32.6 kg.
             This is base_link's OWN mass only (this <mass> tag below), not the
             full vehicle total -- the davit and helipad links added later each
             carry their own separate <inertial> (1.0 kg and 0.5 kg), not
             folded into this figure. -->
        <pose>-0.05 0 -0.168405 0 0 0</pose>
        <mass>32.6</mass>
        <inertia>
          <ixx>2.940147</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.132460</iyy>
          <iyz>0</iyz>
          <izz>6.107813</izz>
        </inertia>
      </inertial>
      <collision name="hull_collision">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_hull_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="hull_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_hull.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0 0 1 1</diffuse>
          <ambient>1 0 1 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="aerial_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_aerial.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="crosstube_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_crosstube.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <!-- flag_visual (blueboat_flag.dae) removed here: real vertex-transformed bounding-box
           measurement (Task 10 lidar-self-occlusion fix) shows it's a near-vertical signal-flag
           pole at x[-0.583,-0.281] y[-0.332,-0.322] z[0.019,1.019] relative to base_link -- a
           thin near-vertical column ~1m tall at r~0.43m from the lidar mount. Because it spans
           almost the full 0-1.1m height range at a fixed bearing, virtually any practical lidar
           mount height between those bounds gets a 0-elevation beam through it regardless of
           mount x/y, causing guaranteed self-hits. Unlike the aerial mast (cleared by raising
           the mount, see lidar_link pose below), there is no reasonable mount height that clears
           this one. It's also a maritime signal flag -- irrelevant hardware for an underground
           tracked cave-mapping vehicle, same rationale Task 4 used to remove the motor/prop
           assemblies. -->
      <visual name="frame_asm_fore_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_frame_asm_fore.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.9</metalness>
              <roughness>0.1</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="frame_asm_aft_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_frame_asm_aft.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.9</metalness>
              <roughness>0.1</roughness>
