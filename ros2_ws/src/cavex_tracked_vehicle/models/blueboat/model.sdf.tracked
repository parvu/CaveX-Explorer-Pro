<!-- CaveX-Explorer-Pro: BlueBoat tracked-vehicle variant.
     Derived from ArduPilot's real vendored `blueboat` Gazebo model (author Rhys Mainwaring,
     meshes sourced from Blue Robotics' published CAD). This is NOT an official Blue Robotics
     tracked-vehicle product -- it is this project's own modification, replacing the boat's
     motor/prop assemblies with retractable track assemblies for cave-floor locomotion.
     NOTE: model.config in this dir still only declares model.sdf (the untouched vendored
     original); it does not point at this file. Whichever later task actually spawns the
     tracked variant (Task 5/6) needs its own model.config (or a launch-time SDF path override)
     pointing at model.sdf.tracked instead. -->
<sdf version="1.9">
  <model name="cavex_tracked_blueboat">
    <link name="base_link">
      <inertial>
        <!-- Re-derived via the parallel-axis theorem after removing the motor/prop assemblies
             (~0.4kg total) and grafting on two 1.5kg retractable track assemblies.

             STEP 1 -- true combined CoM (weighted average of component CoMs, not the old
             hull-only CoM):
               hull:        29.6 kg @ (-0.05,  0,     -0.15)
               left_track:   1.5 kg @ (-0.05,  0.35,  -0.35)
               right_track:  1.5 kg @ (-0.05, -0.35,  -0.35)
               total mass = 32.6 kg
               x_com = -0.05 (all components share x=-0.05)
               y_com = (29.6*0 + 1.5*0.35 + 1.5*(-0.35)) / 32.6 = 0  (left/right cancel)
               z_com = (29.6*(-0.15) + 1.5*(-0.35) + 1.5*(-0.35)) / 32.6
                     = (-4.44 - 0.525 - 0.525) / 32.6 = -5.49 / 32.6 = -0.168405
             -> new combined CoM: (-0.05, 0, -0.168405), an 0.0184m / ~12% shift from the old
                -0.15 hull-only pose declared here previously.

             STEP 2 -- parallel-axis theorem about this NEW combined CoM (not the old one).
             Shift hull by d_hull = new_com - hull_com = (0, 0, -0.018405):
               dIxx_hull = 29.6*(0^2 + 0.018405^2) = 29.6*0.00033874 = 0.010027
               dIyy_hull = 29.6*(0^2 + 0.018405^2) = 0.010027
               dIzz_hull = 29.6*(0^2 + 0^2)         = 0
               ixx_hull' = 2.42369  + 0.010027 = 2.433717
               iyy_hull' = 3.9235025 + 0.010027 = 3.933530
               izz_hull' = 5.6403125 + 0        = 5.640313
             Shift each track (own local inertia ixx=0.02/iyy=0.05/izz=0.05 from the track link
             below) by d_track = new_com - track_com = (0, +/-0.35, +0.181595):
               dIxx_track = 1.5*(0.35^2 + 0.181595^2) = 1.5*(0.1225+0.032977) = 0.233215
               dIyy_track = 1.5*(0^2    + 0.181595^2) = 1.5*0.032977          = 0.049465
               dIzz_track = 1.5*(0^2    + 0.35^2)     = 1.5*0.1225            = 0.18375
               ixx_track' = 0.02 + 0.233215 = 0.253215  (x2 tracks = 0.506430)
               iyy_track' = 0.05 + 0.049465 = 0.099465  (x2 tracks = 0.198930)
               izz_track' = 0.05 + 0.18375  = 0.23375   (x2 tracks = 0.4675)
             Sum (hull' + left_track' + right_track'):
               ixx: 2.433717 + 0.506430 = 2.940147
               iyy: 3.933530 + 0.198930 = 4.132460
               izz: 5.640313 + 0.467500 = 6.107813
             Off-diagonal terms stay 0: x is uniform across all components, and the left/right
             track y-offsets are equal and opposite so any xy/yz cross terms cancel.
             mass: 29.6 (hull, motors/props removed) + 2*1.5 (tracks) = 32.6 kg -->
        <pose>-0.05 0 -0.168405 0 0 0</pose>
        <mass>32.6</mass>
        <inertia>
          <ixx>2.940147</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.132460</iyy>
          <iyz>0</iyz>
          <izz>6.107813</izz>
        </inertia>
      </inertial>
      <collision name="hull_collision">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_hull_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="hull_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_hull.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0 0 1 1</diffuse>
          <ambient>1 0 1 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="aerial_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_aerial.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="crosstube_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_crosstube.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <!-- flag_visual (blueboat_flag.dae) removed here: real vertex-transformed bounding-box
           measurement (Task 10 lidar-self-occlusion fix) shows it's a near-vertical signal-flag
           pole at x[-0.583,-0.281] y[-0.332,-0.322] z[0.019,1.019] relative to base_link -- a
           thin near-vertical column ~1m tall at r~0.43m from the lidar mount. Because it spans
           almost the full 0-1.1m height range at a fixed bearing, virtually any practical lidar
           mount height between those bounds gets a 0-elevation beam through it regardless of
           mount x/y, causing guaranteed self-hits. Unlike the aerial mast (cleared by raising
           the mount, see lidar_link pose below), there is no reasonable mount height that clears
           this one. It's also a maritime signal flag -- irrelevant hardware for an underground
           tracked cave-mapping vehicle, same rationale Task 4 used to remove the motor/prop
           assemblies. -->
      <visual name="frame_asm_fore_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_frame_asm_fore.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.9</metalness>
              <roughness>0.1</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="frame_asm_aft_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_frame_asm_aft.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.9</metalness>
              <roughness>0.1</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="hatch_asm_stbd">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_hatch_asm_stbd.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="hatch_asm_port">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_hatch_asm_port.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
    <!-- motor_stbd_visual / motor_port_visual (real motor housing meshes) removed here:
         tracked variant has no props/motors, replaced below by track assemblies. -->

    <!-- motor_stbd_link / motor_port_link / motor_*_joint (real prop-driven motor assemblies)
         removed here: tracked variant does not drive props. Replaced with two retractable
         track assemblies mounted at the same points the real motors used to occupy
         (-0.488 -0.295 -0.272 / -0.488 0.295 -0.272), per this project's own design pass
         (box-primitive track geometry -- the real BlueBoat has no track hardware, so there
         is no real mesh/CAD to vendor for these parts). -->

    <link name="left_track_retract_mount">
      <pose>-0.05 0.35 -0.2 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <joint name="left_track_retract_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_track_retract_mount</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>1.4</upper>
          <effort>50</effort>
          <velocity>1.0</velocity>
        </limit>
      </axis>
    </joint>
    <link name="left_track">
      <pose relative_to="left_track_retract_mount">0 0 -0.15 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.05</iyy>
          <izz>0.05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="col">
        <geometry>
          <box>
            <size>0.6 0.12 0.15</size>
          </box>
        </geometry>
      </collision>
      <visual name="vis">
        <geometry>
          <box>
            <size>0.6 0.12 0.15</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="left_track_fixed" type="fixed">
      <parent>left_track_retract_mount</parent>
      <child>left_track</child>
    </joint>

    <link name="right_track_retract_mount">
      <pose>-0.05 -0.35 -0.2 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <joint name="right_track_retract_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_track_retract_mount</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>1.4</upper>
          <effort>50</effort>
          <velocity>1.0</velocity>
        </limit>
      </axis>
    </joint>
    <link name="right_track">
      <pose relative_to="right_track_retract_mount">0 0 -0.15 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.05</iyy>
          <izz>0.05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="col">
        <geometry>
          <box>
            <size>0.6 0.12 0.15</size>
          </box>
        </geometry>
      </collision>
      <visual name="vis">
        <geometry>
          <box>
            <size>0.6 0.12 0.15</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="right_track_fixed" type="fixed">
      <parent>right_track_retract_mount</parent>
      <child>right_track</child>
    </joint>

    <!-- sensors -->
    <link name="imu_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
    </link>
    <joint name="imu_joint" type="revolute">
      <child>imu_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
    </joint>


    <!-- NavSat -->

    <link name="navsat_link">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name="navsat_sensor" type="navsat">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1.0</update_rate>
        <topic>navsat</topic>
        <gps>
          <fix>
            <service>1</service>
            <status>0</status>
          </fix>
        </gps>
      </sensor>
    </link>
    <joint name="navsat_joint" type="fixed">
      <parent>imu_link</parent>
      <child>navsat_link</child>
    </joint>

    <!-- Lidar/camera (added post-Task-7 review, Finding 1: Task 4 never gave
         this hull any perception sensors, only imu/navsat -- Task 10's
         RTAB-Map hard-depends on /lidar/points + /camera/color/*). Native
         SDF <sensor> blocks directly under a fixed-mounted <link>, no
         <gazebo reference=...> wrapper -- that wrapper is URDF-to-SDF-xacro
         syntax only and this file is plain SDF already (same convention
         this file's own ros2_control/plugin comments already establish).
         Real values (16-beam 360 deg gpu_lidar @10Hz, range 0.3-12m; camera
         30Hz 800x800 R8G8B8) and the real proven gz-sim8 gotcha
         (<gz_frame_id> required or gz-sim stamps frame_id from the scene
         graph instead of the link name) both carried over from the
         a prior project vehicle's real, working sensor URDF blocks -- same
         sensor types, same requirement, re-verified live for this hull
         rather than assumed.
         Mount heights picked from blueboat_hull_collision.stl's real
         bounding box (x:[-0.60,0.59] y:[-0.45,0.45] z:[-0.376,0] relative to
         base_link -- hull collision top sits at z=0): both sensors sit at
         z>=0.15, clear of the hull collision mesh and the track assemblies
         below. Camera mounted at the bow (+x, matching the hull's forward
         extent and the +x-is-forward drive convention TrackedVehicle/
         track_cmd_vel_bridge.py already use post-frame-fix). -->
    <link name="lidar_link">
      <!-- Raised from 0.4 to 0.55 (Task 10 lidar-self-occlusion fix): real vertex-transformed
           bounding box of the aerial/antenna mast (blueboat_aerial.dae) is x[0.170,0.192]
           y[-0.375,-0.353] z[0.004,0.318] -- r~0.406m from the mount, top at z=0.318. At the
           old 0.4m mount that top was only 11.4 degrees below horizontal (within the +/-15deg
           vertical FOV), so it self-hit. At 0.55m the same point is 29.7 degrees below
           horizontal -- clear, with margin. All other remaining superstructure (hull, frame_asm,
           crosstube, hatch_asm) tops out at z<=0.091, at r>=0.214m -- angle to those from a
           0.55m mount is >58 degrees, well outside the cone. (blueboat_flag.dae, the one piece
           that couldn't be cleared by any reasonable mount height, was removed above instead.) -->
      <pose relative_to="base_link">0 0 0.55 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name="lidar_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>lidar/points</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.2618</min_angle>
              <max_angle>0.2618</max_angle>
            </vertical>
          </scan>
          <range>
            <!-- min tightened from 0.3 to 0.4 (Task 10 lidar-self-occlusion fix): filters
                 remaining close-range self-hit noise without excluding real near-range cave
                 features (cave walls/obstacles can legitimately be within 1-2m). -->
            <min>0.4</min>
            <max>12.0</max>
          </range>
        </ray>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <link name="camera_link">
      <pose relative_to="base_link">0.55 0 0.15 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name="camera_sensor" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30.0</update_rate>
        <topic>camera/color</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>800</width>
            <height>800</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- plugins -->
    <plugin name="gz::sim::systems::JointStatePublisher"
      filename="gz-sim-joint-state-publisher-system">
    </plugin>
    <plugin name="gz::sim::systems::OdometryPublisher"
      filename="gz-sim-odometry-publisher-system">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>

    <!-- left/right motor Thruster plugins removed here: tracked variant isn't driven by props. -->

    <!-- Track-drive plugins: real gz-sim-track-controller-system (per-track belt speed) +
         gz-sim-tracked-vehicle-system (skid-steer body_link/left_track/right_track ->
         per-track velocity), parameter names/nesting empirically confirmed against gz-sim8's
         actual TrackedVehicle.cc source by Task 3's throwaway rig (see task-3-report.md).
         NOTE: Task 3 found body_link/left_track/right_track are NOT parsed uniformly --
         body_link is read as element TEXT content (_sdf->Get<std::string>("body_link")), but
         left_track/right_track are read from a `link` XML ATTRIBUTE
         (sdfElem->Get<std::string>("link")), not element text. Using text content for
         left_track/right_track (as an early attempt did) parses with no SDF-schema error and
         loads silently, but at runtime builds a malformed topic
         (.../link//track_cmd_vel -> sanitized to .../linktrack_cmd_vel) that nothing
         subscribes to -- commands are silently dropped. Fixed form below, verified via -v 4
         debug logs showing no "Failed to find left/right track" warnings. -->
    <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
      <link>left_track</link>
      <track_orientation>1 0 0</track_orientation>
      <max_velocity>2.0</max_velocity>
      <max_acceleration>2.0</max_acceleration>
    </plugin>
    <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
      <link>right_track</link>
      <track_orientation>1 0 0</track_orientation>
      <max_velocity>2.0</max_velocity>
      <max_acceleration>2.0</max_acceleration>
    </plugin>
    <plugin filename="gz-sim-tracked-vehicle-system" name="gz::sim::systems::TrackedVehicle">
      <body_link>base_link</body_link>
      <left_track link="left_track"/>
      <right_track link="right_track"/>
      <tracks_separation>0.7</tracks_separation> <!-- left/right track mount y=+-0.35 per Task 4 -->
      <max_velocity>2.0</max_velocity>
      <max_acceleration>2.0</max_acceleration>
    </plugin>

    <!-- Retraction-joint actuation: real ros2_control + gz_ros2_control bridge, same pattern
         already proven on a prior project vehicle. position_proportional_gain is a
         GazeboSimSystem-wide SDF <plugin> child element, NOT a per-joint
         <ros2_control>/<param> -- confirmed the hard way there by reading gz_ros2_control's
         real upstream source. Reused directly here rather than rediscovered. -->
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="left_track_retract_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.4</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_track_retract_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.4</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <!-- $(find pkg) is a xacro macro, not something gz_ros2_control expands: this is native
           SDF (no xacro preprocessing step), so gz_ros2_control::GazeboSimROS2ControlPlugin's
           Configure() passes <parameters> straight to rclcpp as a literal --params-file path.
           Confirmed the hard way -- `$(find cavex_tracked_vehicle)/config/...yaml` verbatim
           aborts the whole gz-sim process at model load (rclcpp::exceptions::RCLInvalidROSArgsError,
           "Error opening YAML file"). Using a real filesystem path instead, matching this
           project's existing convention of worktree-absolute paths (see ardupilot_gazebo_env.sh).
           ponytail: hardcoded to this worktree, not portable across machines/CI -- if this ever
           needs to run outside this checkout, template it (e.g. a launch file substituting
           FindPackageShare('cavex_tracked_vehicle') before spawning) instead of a literal path.
           Task 7 did exactly that: gazebo_tracked_vehicle.launch.py reads this checked-in file
           at launch time and replaces the placeholder token in the <parameters> tag below (see
           its literal value there -- not repeated here in the comment, since this file is
           processed with a whole-file string .replace() and a second literal occurrence here
           would get mangled too) with a real FindPackageShare('cavex_tracked_vehicle')-resolved
           path, writing the result to a
           generated temp file that is what actually gets spawned. This file itself is now a
           template (the token is not a valid path -- direct `gz sim model.sdf.tracked`
           throwaway loading, as Task 5 did for verification, needs the same substitution done
           by hand first, or just launch gazebo_tracked_vehicle.launch.py instead). -->
      <parameters>__ROS2_CONTROL_PARAMS_PATH__</parameters>
      <position_proportional_gain>20.0</position_proportional_gain>
    </plugin>

    <!-- Hydrodynamics plugin (gz-waves1-hydrodynamics-system) removed: real, root-caused
         finding, not a nicety. It's the original BlueBoat's water-buoyancy physics,
         irrelevant for this tracked, land-only variant that never enters water under its
         own power (Task 4 removed the motor/Thruster plugins for the same reason but missed
         this one). Its shared library isn't installed in this environment
         ("Failed to load system plugin [gz-waves1-hydrodynamics-system]: Could not find
         shared library", confirmed live in gz sim's own console output), and because it was
         listed immediately before ArduPilotPlugin in this file, its load failure was
         silently aborting ArduPilotPlugin's own loading too -- ArduPilotPlugin never
         initialized, so ArduPilot's DDS bridge (/ap/arm_motors, /ap/mode_switch) never had a
         live physics-side FDM connection behind it, explaining the "services visible in the
         ROS2 graph but every call hangs forever" symptom investigated at length across
         Tasks 11/12 and this dedicated investigation.
    -->

      <!-- ardupilot plugin
        The original BlueBoat's <control channel="..."> blocks (motor_port_joint /
        motor_stbd_joint, twin-thruster COMMAND channels) have been removed entirely: those
        joints no longer exist in this tracked variant (deleted above), and ArduPilotPlugin
        hard-fails at load ("Couldn't find specified joint") if a <control> block names a
        missing joint -- confirmed via a real spawn with libArduPilotPlugin.so. This is not a
        twin-motor boat anymore, so there is no physically-equivalent per-joint servo channel
        to repoint these at: skid-steer track velocity isn't a servo-angle/thrust output.
        ArduPilot itself still runs (IMU/NavSat in, no actuator commands out) so autopilot
        modes/estimation/telemetry keep working; actually driving the vehicle is Task 6's job,
        which relays ArduPilot's DDS cmd_vel output to the TrackedVehicle plugin's cmd_vel
        topic -- a separate control path that bypasses ArduPilotPlugin's servo channels
        entirely, so no <control> block is needed here at all. -->
    <plugin name="ArduPilotPlugin"
      filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <!-- yaw=90 here is unmodified from the original motored BlueBoat and is
           WRONG for this ground-rover repurposing (confirmed live in Task 7:
           commanding /cmd_vel linear.x produced ArduPilot-reported velocity
           almost entirely on gazebo's y-axis, not x). NOT fixed here on
           purpose -- changing this term risks breaking the EKF convergence
           already verified live in Task 3/6, and re-verifying that was out
           of scope for the fix. Instead compensated downstream with a +90
           deg yaw rotation in track_cmd_vel_bridge.py
           (cavex_tracked_vehicle/cavex_tracked_vehicle/track_cmd_vel_bridge.py)
           before the twist is republished to /track_cmd_vel. If this term
           is ever touched, track_cmd_vel_bridge.py's rotation must be
           revisited (and removed/adjusted) in the same change. -->
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <imuName>imu_link::imu_sensor</imuName>
    </plugin>

    <!-- Carries a BlueROV2 through the dry section as physical cargo, released
         at the water boundary by vehicle_switch_node.py (real Gazebo mechanism,
         gz-sim-detachable-joint-system -- confirmed via the real, working
         reference example at /usr/share/gz/gz-sim8/worlds/detachable_joint.sdf,
         not guessed: the plugin lives on the PARENT model (this one), naming the
         child by its spawn-time top-level entity name). gazebo_tracked_vehicle
         .launch.py spawns bluerov2 BEFORE this model so the child entity already
         exists when this plugin's Configure() resolves it. child_link="base_link"
         matches bluerov2/model.sdf's real main-body link name. Detaching is a
         one-way operation in this plugin (no re-attach mechanism implemented --
         see the SDD ledger for why re-docking is deferred). -->
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>base_link</parent_link>
      <child_model>bluerov2</child_model>
      <child_link>base_link</child_link>
      <detach_topic>/cavex/rov_release/detach</detach_topic>
    </plugin>

    <!-- ROV deployment mechanism: a static A-frame davit visual+collision next to
         the BlueROV2's mount point (x=0, y=0.3, clear of the ROV's own x[-0.23,0.23]
         y[-0.17,0.17] footprint per bluerov2/model.sdf's real collision extents).
         Honest scope: this is a visual/collision representation of a deployment
         davit (a common real launch-and-recovery mechanism for small ROVs), NOT an
         actuated/animated crane -- no joint motion, no winch simulation. The real
         mechanism this project actually deploys the ROV with is
         model.sdf.tracked's own DetachableJoint plugin above; this davit exists so
         the deployment point has a real, visible fixture in the sim rather than
         the ROV appearing to just float free of any visible mount hardware. -->
    <link name="rov_davit_link">
      <pose relative_to="base_link">0 0.3 0.05 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
      </inertial>
      <visual name="rov_davit_post_visual">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><box><size>0.04 0.04 0.3</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="rov_davit_arm_visual">
        <pose>-0.12 0 0.28 0 0.4 0</pose>
        <geometry><box><size>0.28 0.03 0.03</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="rov_davit_post_collision">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><box><size>0.04 0.04 0.3</size></box></geometry>
      </collision>
    </link>
    <joint name="rov_davit_joint" type="fixed">
      <parent>base_link</parent>
      <child>rov_davit_link</child>
    </joint>

    <!-- Helipad, front (bow, +x) of the hull -- placed at x=0.3 (inboard of the
         camera mast at x=0.55/z=0.15, per that link's own real pose, to avoid
         visual/collision clash) so a real x500 quadcopter (vendored below, PX4's
         own Fuel model) has a visible landing platform. Deck-level (z=0, matching
         the hull collision's own real top surface, same reasoning as the ROV
         mount). Purely a flat marked platform -- no elevator/lowering mechanism. -->
    <link name="helipad_link">
      <pose relative_to="base_link">0.3 0 0.005 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
      </inertial>
      <visual name="helipad_deck_visual">
        <geometry><cylinder><radius>0.22</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.85 0.75 0.1 1</ambient><diffuse>0.9 0.8 0.15 1</diffuse></material>
      </visual>
      <collision name="helipad_deck_collision">
        <geometry><cylinder><radius>0.22</radius><length>0.01</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="helipad_joint" type="fixed">
      <parent>base_link</parent>
      <child>helipad_link</child>
    </joint>

    <!-- Carries a real, vendored PX4 x500 quadcopter (fuel.gazebosim.org/PX4/models/
         x500, CC-BY-4.0) on the helipad -- placeholder for future airpocket/aerial
         exploration work, NOT flight-control-integrated here. The vendored model
         itself has real motor/rotor physics (gz-sim-multicopter-motor-model-system)
         but no PX4 SITL/MAVLink connection wired up -- that needs the actual
         PX4-Autopilot SITL binary and its own Gazebo bridge, neither installed in
         this environment (the same class of toolchain-availability risk already
         hit and resolved for microxrceddsgen -- not repeated here since the
         drone's control integration is explicitly out of scope for now). Same
         real DetachableJoint mechanism as the ROV, so a real release path already
         exists for whenever flight control is added. -->
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>base_link</parent_link>
      <child_model>x500</child_model>
      <child_link>base_link</child_link>
      <detach_topic>/cavex/x500_release/detach</detach_topic>
    </plugin>

  </model>
</sdf>
