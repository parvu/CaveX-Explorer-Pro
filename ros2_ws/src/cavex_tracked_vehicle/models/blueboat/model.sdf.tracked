        <geometry>
          <box>
            <size>0.6 0.12 0.15</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <!-- Same sprocket/roller/tread-link detail as left_track above -- see
           its own comments for the full rationale. -->
      <visual name="right_track_sprocket_fore_visual">
