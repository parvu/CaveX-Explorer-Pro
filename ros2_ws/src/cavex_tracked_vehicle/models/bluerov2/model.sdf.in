<?xml version='1.0' encoding='UTF-8'?>
<!-- CaveX-Explorer-Pro: BlueROV2 template. NOTE: unreferenced by any
     script in this project (confirmed 2026-08-26: model.sdf, the
     literal generated copy, is what every real spawn path actually
     uses; nothing here performs @variable substitution on this file).
     Kept in sync with model.sdf's own forced-static decorative
     treatment anyway, for consistency: sensors and all control-stack
     plugins stripped, matching blueboat_tracked_static's pattern. See
     model.sdf's own header for the fuller rationale. -->
<sdf version="1.6">
  <model name=@model_name>
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <!-- BlueROV2 thruster reference: http://www.ardusub.com/introduction/features.html -->

    <link name="base_link">
      <inertial>
        <pose>@center_of_mass_x @center_of_mass_y @center_of_mass_z 0 0 0</pose>
        <mass>@mass</mass>
        <inertia>
          <ixx>@ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@iyy</iyy>
          <iyz>0</iyz>
          <izz>@izz</izz>
        </inertia>
      </inertial>

      <visual name="base_link_visual">
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/bluerov2.dae</uri>
            <scale>0.025 0.025 0.025</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="base_link_collision">
        <pose>@center_of_volume_x @center_of_volume_y @center_of_volume_z 0 0 0</pose>
        <geometry>
          <box>
            <size>@collision_x @collision_y @collision_z</size>
          </box>
        </geometry>
      </collision>

    </link>

    <link name="thruster1">
      <pose>@thruster1_x @thruster1_y @thruster1_z -@d90 @d90 -@d45</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -@d90 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster2">
      <pose>@thruster2_x @thruster2_y @thruster2_z -@d90 @d90 -@d135</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -@d90 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster3">
      <pose>@thruster3_x @thruster3_y @thruster3_z -@d90 @d90 @d45</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 @d90 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster4">
      <pose>@thruster4_x @thruster4_y @thruster4_z -@d90 @d90 @d135</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 @d90 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster5">
      <pose>@thruster5_x @thruster5_y @thruster5_z 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -@d90 0 @d90</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster6">
      <pose>@thruster6_x @thruster6_y @thruster6_z 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 @d90 0 @d90</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="thruster1_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster1</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster2_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster2</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster3_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster3</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster4_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster4</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster5_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster5</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster6_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster6</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

  </model>
</sdf>
