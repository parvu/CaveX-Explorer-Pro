<?xml version='1.0' encoding='UTF-8'?>
<!-- CaveX-Explorer-Pro: BlueROV2, forced-static decorative prop on this
     branch (real request, 2026-08-26: "bluerov2 only decor in main
     branch. remove all sensors from it. so no more sonar this branch").
     All sensors (imu_sensor, the sonar_ray_engine gpu_lidar that used to
     feed the now-removed cavex_sonar package) and all control-stack
     plugins (ArduPilotPlugin/ArduSub, the 6 real Thruster plugins,
     Hydrodynamics) are stripped, matching the same "forced-static,
     control-stack stripped" pattern already used for
     blueboat_tracked_static's own model.sdf. Thruster visual meshes and
     their joints are kept for visual fidelity: with static=true and no
     plugin driving them, they just stay at their fixed spawn pose. See
     perception branch for the full, functional BlueROV2. -->
<sdf version="1.6">
  <model name="bluerov2">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <!-- BlueROV2 thruster reference: http://www.ardusub.com/introduction/features.html -->

    <link name="base_link">
      <inertial>
        <pose>0.0 0.0 0.011 0 0 0</pose>
        <mass>10.05</mass>
        <inertia>
          <ixx>0.099</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.178</iyy>
          <iyz>0</iyz>
          <izz>0.269</izz>
        </inertia>
      </inertial>

      <visual name="base_link_visual">
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/bluerov2.dae</uri>
            <scale>0.025 0.025 0.025</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="base_link_collision">
        <pose>0.0 0.0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.457 0.338 0.065</size>
          </box>
        </geometry>
      </collision>

    </link>

    <link name="thruster1">
      <pose>0.14 -0.092 0.0 -1.571 1.571 -0.785</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster2">
      <pose>0.14 0.092 0.0 -1.571 1.571 -2.356</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster3">
      <pose>-0.14 -0.092 0.0 -1.571 1.571 0.785</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 1.571 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster4">
      <pose>-0.14 0.092 0.0 -1.571 1.571 2.356</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 1.571 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster5">
      <pose>0.0 -0.109 0.077 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 1.571</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster6">
      <pose>0.0 0.109 0.077 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 1.571 0 1.571</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="thruster1_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster1</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster2_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster2</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster3_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster3</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster4_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster4</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster5_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster5</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster6_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster6</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

  </model>
</sdf>
