Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
      Reference Frame: map
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
    - Class: rviz_default_plugins/Map
      Name: RTAB-Map Occupancy Grid
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar Points
      Enabled: true
      Topic:
        Value: /lidar/points
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/PointCloud2
      Name: RTAB-Map Cloud (obstacles)
      Enabled: false
      Topic:
        Value: /cloud_obstacles
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/Odometry
      Name: Ground Truth Path
      Enabled: true
      Topic:
        Value: /odom_ground_truth
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Keep: 500
      Shape:
        Value: Arrow
      Covariance:
        Position:
          Value: false
        Orientation:
          Value: false
    - Class: rviz_default_plugins/Odometry
      Name: SLAM Estimate Path
      Enabled: true
      Topic:
        Value: /cavex/slam/odom
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Keep: 500
      Shape:
        Value: Axes
      Covariance:
        Position:
          Value: false
        Orientation:
          Value: false
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: false
      Topic:
        Value: /camera/color/image_raw
    - Class: rviz_default_plugins/MarkerArray
      Name: Explore Frontiers
      Enabled: true
      Topic:
        Value: /explore/frontiers
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: false
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
      Color Scheme: costmap
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Interact
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_link
      Distance: 15
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
  X: 100
  Y: 100
