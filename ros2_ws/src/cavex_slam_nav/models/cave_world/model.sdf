<?xml version="1.0"?>
<sdf version="1.9">
  <model name="cave_world">
    <static>true</static>
    <link name="cave_link">
      <!-- Scaled 2x by real request (testing whether a proportionally
           larger cave fixes persistent tight-corridor stuck issues).
           <scale> as a child of the world file's <include> does not work
           in this sdformat/gz-sim version (confirmed live -- a real "not
           defined in SDF" parser warning, silently ignored); <scale>
           inside <mesh> geometry, here, is the actual mechanism that
           works. This is the one deviation from this model's otherwise
           vendored-unmodified status (see README's third-party-assets
           section) -- a real, necessary one, not a stylistic edit. -->
      <!-- 2026-08-29: box floor patches in cavex_world.world LOWERED to hole-fill
           depth (top well below the mesh floor) so the tracked vehicle rides
           the real rugged mesh floor and the two surfaces no longer fight;
           patches only catch the vehicle over actual gaps in the mesh.
           Prior note (kept for context): the mesh COLLISION had been The 2x-scaled cave mesh has
           real structure (wall bulges, floor relief) standing in the drive
           corridor -- box-on-trimesh contact wedged the tracked vehicle and
           it rode up mesh features it should pass. Containment for the drive
           area now comes from the box floor patches + box side/boundary
           walls + ceilings in cavex_world.world (the dry-section side walls,
           removed 2026-08-27, are re-added there). The visual mesh stays for
           the map's look; anything the vehicle can physically reach is a box. -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://cave_world/meshes/cave_world_holed.obj</uri>
            <scale>2 2 2</scale>
          </mesh>
        </geometry>
        <surface>
          <friction><ode><mu>0.45</mu><mu2>0.45</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://cave_world/meshes/cave_world_holed.obj</uri>
            <scale>2 2 2</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
