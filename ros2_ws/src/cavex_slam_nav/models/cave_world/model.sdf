<?xml version="1.0"?>
<sdf version="1.9">
  <model name="cave_world">
    <static>true</static>
    <link name="cave_link">
      <!-- Scaled 2x by real request (testing whether a proportionally
           larger cave fixes persistent tight-corridor stuck issues).
           <scale> as a child of the world file's <include> does not work
           in this sdformat/gz-sim version (confirmed live -- a real "not
           defined in SDF" parser warning, silently ignored); <scale>
           inside <mesh> geometry, here, is the actual mechanism that
           works. This is the one deviation from this model's otherwise
           vendored-unmodified status (see README's third-party-assets
           section) -- a real, necessary one, not a stylistic edit. -->
      <!-- 2026-08-29: mesh split into two files, both cropped to the play area
           (world x[-130,40] y[-60,30] z<=50, isolated tile-fragments removed --
           meshes/tools/trim_cave_mesh.py):
             collision = cave_world_holed.obj  -- basin void kept for real depth,
                         PLUS the draped cavex_floor_seal sheet baked in
                         (meshes/tools/add_floor_seal.py) to close the vendored
                         mesh's pervasive floor gaps. One trimesh -> one BVH.
             visual    = cave_world_visual.obj -- clean crop, no basin hole, no
                         seal, so the seal is never drawn.
           This replaces the old cave_floor_patch* boxes and the short-lived
           standalone cave_floor_seal.obj second-collision. -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://cave_world/meshes/cave_world_holed.obj</uri>
            <scale>2 2 2</scale>
          </mesh>
        </geometry>
        <surface>
          <friction><ode><mu>0.45</mu><mu2>0.45</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://cave_world/meshes/cave_world_visual.obj</uri>
            <scale>2 2 2</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
