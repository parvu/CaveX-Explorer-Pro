<?xml version="1.0"?>
<sdf version="1.9">
  <model name="cave_world">
    <static>true</static>
    <link name="cave_link">
      <collision name="collision">
        <geometry>
          <mesh><uri>model://cave_world/meshes/cave_world.obj</uri></mesh>
        </geometry>
        <surface>
          <contact><ode><max_vel>0.01</max_vel></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh><uri>model://cave_world/meshes/cave_world.obj</uri></mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
