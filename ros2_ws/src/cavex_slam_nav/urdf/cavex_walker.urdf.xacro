<?xml version="1.0"?>
<!--
  Spot-like quadruped (CHAMP) — NOT Boston Dynamics' proprietary Spot model.

  Dimension sources:
  - Hip mount offsets, thigh (upper-leg) lateral offset, thigh length, and
    shank (lower-leg) length below are copied verbatim from CHAMP's own
    vendored Spot example, chvmp/robots' `configs/spot_config/config.json`
    ("firmware.transforms", cloned at
    https://github.com/chvmp/robots.git for this task). Those are real
    kinematic offsets CHAMP ships for its Spot-like example, not invented.
  - `nominal_height` (base_footprint -> base_link static offset below) is
    likewise copied from that same repo's
    `configs/spot_config/config/gait/gait.yaml` (0.48 m).
  - chvmp/robots' spot_config has no primitive body-box size: its
    `config.json` sets `"default_urdf": false` and points at an external,
    unvendored `spot_description` mesh package. So the base_link box
    (0.7 x 0.3 x 0.15 m) below is NOT from that source or from Boston
    Dynamics' spec sheet — it's sized to comfortably enclose the real hip
    offsets above (front/rear hip spread 0.5957 m, left/right hip spread
    0.11 m) with a modest chassis margin, same simple-primitives style as
    cavex_robot.urdf.xacro's base_link.

  Joint naming: CHAMP's `quadruped_controller_node` reads joint names from
  ROS params (`joints_map.*`, see champ/include/champ/utils/urdf_loader.h -
  they are NOT hardcoded in champ/champ_base source), so this file is free
  to choose names. We use the <leg>_<hip|thigh|knee>_joint convention this
  task's brief specifies, with leg prefixes lf/rf/lh/rh (left/right,
  front/hind) — mapped onto CHAMP's own 3-joint-per-leg chain as:
    hip_joint   = CHAMP's "hip_x" (roll / abduction, mounted on base_link)
    thigh_joint = CHAMP's "hip_y" (pitch, lifts the thigh)
    knee_joint  = CHAMP's "knee"  (pitch, bends the shank)
  CHAMP's config additionally carries a 4th, non-actuated "foot" frame per
  leg for FK bookkeeping; this file omits it as a controlled joint (not
  needed for gz_ros2_control's command interface) but Task 5 adds a fixed
  <leg>_foot_link/<leg>_foot_joint pair per leg below anyway: champ's
  links_map schema (champ/include/champ/utils/urdf_loader.h,
  champ/include/champ/quadruped_base/quadruped_leg.h's 4-element
  joint_chain) requires exactly 4 link names per leg to walk the kinematic
  chain for its own internal forward kinematics (hip -> upper_leg ->
  lower_leg -> foot). Without a real foot_link offset by -shank_length from
  knee_link, champ's link chain would be one segment short and its leg IK
  would be computed for the wrong leg length. See
  cavex_walker_joints_map.yaml for how links_map/joints_map reference these
  names.
-->
<robot name="cavex_walker" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Body -->
  <xacro:property name="body_length" value="0.7"/>
  <xacro:property name="body_width" value="0.3"/>
  <xacro:property name="body_height" value="0.15"/>
  <xacro:property name="nominal_height" value="0.48"/> <!-- CHAMP spot_config gait.yaml nominal_height -->

  <!-- Leg geometry (chvmp/robots configs/spot_config/config.json firmware.transforms) -->
  <xacro:property name="hip_x_offset" value="0.29785"/>    <!-- base_link -> hip_joint, front/rear -->
  <xacro:property name="hip_y_offset" value="0.055"/>      <!-- base_link -> hip_joint, left/right -->
  <xacro:property name="thigh_y_offset" value="0.110945"/> <!-- hip_joint -> thigh_joint, lateral -->
  <xacro:property name="thigh_x_offset" value="0.025"/>    <!-- thigh_joint -> knee_joint, forward -->
  <xacro:property name="thigh_length" value="0.3205"/>     <!-- thigh_joint -> knee_joint, vertical -->
  <xacro:property name="shank_length" value="0.37"/>       <!-- knee_joint -> foot, vertical -->
  <xacro:property name="leg_radius" value="0.035"/>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${nominal_height}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="yellow"><color rgba="1 1 0 1"/></material>
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="0.2" ixy="0" ixz="0" iyy="0.3" iyz="0" izz="0.3"/>
    </inertial>
  </link>

  <!-- One leg: hip (roll) -> thigh (pitch) -> knee (pitch) -->
  <xacro:macro name="champ_leg" params="prefix x_sign y_sign">
    <link name="${prefix}_hip_link">
      <visual>
        <geometry><cylinder radius="${leg_radius}" length="0.08"/></geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <material name="black"><color rgba="0 0 0 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${leg_radius}" length="0.08"/></geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      </collision>
      <inertial>
        <mass value="0.6"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${prefix}_hip_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_hip_link"/>
      <origin xyz="${x_sign*hip_x_offset} ${y_sign*hip_y_offset} 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.75" upper="0.75" effort="20" velocity="10"/>
    </joint>

    <link name="${prefix}_thigh_link">
      <visual>
        <geometry><cylinder radius="${leg_radius}" length="${thigh_length}"/></geometry>
        <origin xyz="0 0 -${thigh_length/2}" rpy="0 0 0"/>
        <material name="black"><color rgba="0 0 0 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${leg_radius}" length="${thigh_length}"/></geometry>
        <origin xyz="0 0 -${thigh_length/2}" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.8"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${prefix}_thigh_joint" type="revolute">
      <parent link="${prefix}_hip_link"/>
      <child link="${prefix}_thigh_link"/>
      <origin xyz="0 ${y_sign*thigh_y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.5" upper="1.5" effort="20" velocity="10"/>
    </joint>

    <link name="${prefix}_knee_link">
      <visual>
        <geometry><cylinder radius="${leg_radius}" length="${shank_length}"/></geometry>
        <origin xyz="0 0 -${shank_length/2}" rpy="0 0 0"/>
        <material name="black"><color rgba="0 0 0 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${leg_radius}" length="${shank_length}"/></geometry>
        <origin xyz="0 0 -${shank_length/2}" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${prefix}_knee_joint" type="revolute">
      <parent link="${prefix}_thigh_link"/>
      <child link="${prefix}_knee_link"/>
      <origin xyz="${thigh_x_offset} 0 -${thigh_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.5" upper="0.0" effort="20" velocity="10"/>
    </joint>

    <!-- Virtual foot frame: fixed, offset by -shank_length from the knee.
         Originally exists solely so champ's links_map has a real 4th link
         per leg with the correct shank length baked into its FK (see
         header comment) - but an empty link with no <collision> means the
         only ground-contact surface on the whole leg is the shank cylinder
         well above the foot, which barely grazes the floor during the
         gait's stance/swing cycle. Found empirically (Task 7 fix round 1):
         with stance now held correctly (position_proportional_gain fix),
         the walker still produced ~0 net displacement under a real forward
         /cmd_vel - the legs cycle through the correct commanded gait angles
         but generate no measurable push-off. Adding a real small-sphere
         collision here, plus higher ODE surface friction than the default
         (~1.0), gives the gait a real contact point to plant and push
         against. -->
    <link name="${prefix}_foot_link">
      <visual>
        <geometry><sphere radius="0.04"/></geometry>
        <material name="black"><color rgba="0 0 0 1"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${prefix}_foot_joint" type="fixed">
      <parent link="${prefix}_knee_link"/>
      <child link="${prefix}_foot_link"/>
      <origin xyz="0 0 -${shank_length}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${prefix}_foot_link">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:champ_leg prefix="lf" x_sign="1"  y_sign="1"/>
  <xacro:champ_leg prefix="rf" x_sign="1"  y_sign="-1"/>
  <xacro:champ_leg prefix="lh" x_sign="-1" y_sign="1"/>
  <xacro:champ_leg prefix="rh" x_sign="-1" y_sign="-1"/>

  <!-- ros2_control hardware interface block. Found missing empirically:
       `gz_ros2_control::GazeboSimROS2ControlPlugin` (the <gazebo><plugin>
       block above) only supplies the controller_manager YAML - it still
       needs this separate <ros2_control> tag in the URDF itself to know
       which joints exist and what command/state interfaces they expose.
       Without it, gz-sim's controller_manager aborts on spawn with
       "no 'ros2_control' tag found in the URDF" (std::terminate, process
       exit 134) - reproduced and confirmed via a real launch attempt
       before adding this block, not assumed. Hardware plugin name/type
       confirmed installed, not guessed:
       `cat /opt/ros/jazzy/share/gz_ros2_control/gz_hardware_plugins.xml`
       -> pluginlib class name "gz_ros2_control/GazeboSimSystem". Command
       interface limits match each joint's own <limit> above. -->
  <!-- gz_ros2_control's GazeboSimSystem drives a "position" command
       interface as a proportional controller on top of Gazebo's underlying
       velocity/effort actuation, gain read from a joint-level
       "position_proportional_gain" <param> (confirmed by `strings` on the
       installed /opt/ros/jazzy/lib/libgz_ros2_control-system.so, which
       declares/reads that exact parameter name, not the p/i/d-under-
       command_interface scheme documented for some other gz_ros2_control
       plugin versions, which this installed build does not read at all).
       Absent this param it defaults to a value far too weak to move a
       20kg legged body's joints against gravity, so the walker never
       actually translates despite receiving valid trajectory commands
       (confirmed empirically: driving /cmd_vel for 10s moved the body
       ~0.00001m). 50.0 sized to comfortably saturate each joint's own
       effort=20 limit for a fast, stable step response. -->
  <xacro:macro name="champ_ros2_control_joint" params="name lower upper">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <param name="position_proportional_gain">300.0</param>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:champ_ros2_control_joint name="lf_hip_joint"   lower="-0.75" upper="0.75"/>
    <xacro:champ_ros2_control_joint name="lf_thigh_joint" lower="-1.5"  upper="1.5"/>
    <xacro:champ_ros2_control_joint name="lf_knee_joint"  lower="-2.5"  upper="0.0"/>
    <xacro:champ_ros2_control_joint name="rf_hip_joint"   lower="-0.75" upper="0.75"/>
    <xacro:champ_ros2_control_joint name="rf_thigh_joint" lower="-1.5"  upper="1.5"/>
    <xacro:champ_ros2_control_joint name="rf_knee_joint"  lower="-2.5"  upper="0.0"/>
    <xacro:champ_ros2_control_joint name="lh_hip_joint"   lower="-0.75" upper="0.75"/>
    <xacro:champ_ros2_control_joint name="lh_thigh_joint" lower="-1.5"  upper="1.5"/>
    <xacro:champ_ros2_control_joint name="lh_knee_joint"  lower="-2.5"  upper="0.0"/>
    <xacro:champ_ros2_control_joint name="rh_hip_joint"   lower="-0.75" upper="0.75"/>
    <xacro:champ_ros2_control_joint name="rh_thigh_joint" lower="-1.5"  upper="1.5"/>
    <xacro:champ_ros2_control_joint name="rh_knee_joint"  lower="-2.5"  upper="0.0"/>
  </ros2_control>

  <!-- Lidar (3D) -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.1"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${body_height/2 + 0.1}" rpy="0 0 0"/>
  </joint>

  <!-- Camera -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${body_length/2} 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Harmonic (gz-sim) sensors. Same convention as cavex_robot.urdf.xacro:
       gz-sim's Sensors system publishes over gz-transport with no per-sensor
       plugin, but every sensor MUST carry <gz_frame_id> — without it gz-sim
       stamps frame_id with its own scene-graph path instead of the URDF
       link name, and TF lookups against robot_state_publisher's tree
       (which uses the URDF link names) silently fail. -->
  <gazebo reference="lidar_link">
    <sensor type="gpu_lidar" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>lidar/points</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <ray>
        <scan>
          <horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14</min_angle><max_angle>3.14</max_angle></horizontal>
          <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.2618</min_angle><max_angle>0.2618</max_angle></vertical>
        </scan>
        <range><min>0.3</min><max>12.0</max></range>
      </ray>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor type="camera" name="camera_sensor">
      <update_rate>30.0</update_rate>
      <topic>camera/color</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image><width>800</width><height>800</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>300</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="base_link">
    <sensor type="imu" name="imu_sensor">
      <update_rate>50</update_rate>
      <topic>imu</topic>
      <gz_frame_id>base_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- Real joints driven by ros2_control, not a free body: gz_ros2_control
       bridges the joint_state_broadcaster / champ_controller (see
       cavex_walker_ros2_control.yaml) to Gazebo, replacing cavex_robot's
       VelocityControl/OdometryPublisher plugins used for its wheeled base.
       filename/class verified against the installed package:
       `ros2 pkg prefix gz_ros2_control` -> lib/libgz_ros2_control-system.so,
       class gz_ros2_control::GazeboSimROS2ControlPlugin (gz_ros2_control_plugin.hpp). -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find cavex_slam_nav)/config/cavex_walker_ros2_control.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Ground-truth world pose (Task 5 Step 3). This robot has no
       OdometryPublisher (that was cavex_robot's wheeled/VelocityControl
       approach) - a legged robot's true pose isn't a commanded-velocity
       integral, so we publish the model's real simulator-internal pose
       instead. Same honesty standard as cavex_robot's /odom: this is
       simulator ground truth, not a claim about real-hardware sensing.
       Bridged to ROS as geometry_msgs/PoseArray (gz.msgs.Pose_V) -
       differs from cavex_robot's nav_msgs/Odometry-shaped ground truth, so
       Task 10's ate_evaluator_node.py (which expects Odometry) needs a
       small PoseArray -> Odometry republisher, not a direct bridge.
       filename verified installed: `find / -iname "*pose-publisher*"` ->
       libgz-sim8-pose-publisher-system.so / symlinked as
       gz-sim-pose-publisher-system.so; class name gz::sim::systems::
       PosePublisher confirmed via `strings` on that .so. -->
  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <update_frequency>30</update_frequency>
    </plugin>
  </gazebo>
</robot>
