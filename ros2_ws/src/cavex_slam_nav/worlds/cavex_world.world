<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="cavex_world">
    <!-- Real gap found and fixed: this file had NO <gui> element at all,
         so every GUI launch fell back to gz-sim's generic default camera
         pose (-6 0 6 0 0.5 0) -- nowhere near this world's actual action
         (the cave mesh itself sits far from world origin, per the
         cave_world include's own pose below, and every spawn point used in
         this project is out near x=20+ or x=-88). Confirmed as the real
         cause of "I don't see the ROV" complaints even when ground-truth
         pose showed it was really there and moving -- not a rendering bug,
         just an unaimed camera.

         First attempt at this fix used a bare <gui><camera> shorthand --
         wrong syntax, gz-sim logged "<gui><camera> can't be converted yet"
         and silently ignored the whole block (confirmed via a headless
         load check). The real, working mechanism is a <plugin
         filename="MinimalScene"> with a <camera_pose> child -- verified by
         reading the actual installed default GUI config
         (/usr/share/gz/gz-sim8/gui/gui.config, from the gz-sim8 apt
         package), not guessed.

         A second pass initially copied that default config's FULL plugin
         set (window chrome, world stats, entity tree, transform/
         screenshot/copy-paste tools, etc.) wholesale -- correct in
         principle (reuse tested upstream config over hand-rolling), but it
         crowded the window with floating toolbars nobody asked for. Pared
         down to the 4 plugins actually needed: MinimalScene (3D view, with
         the camera_pose fix), GzSceneManager (required -- this is what
         syncs simulated entities into the render scene at all, removing it
         would break visuals again), InteractiveViewControl (mouse
         drag/scroll camera control), WorldControl (play/pause). WorldStats
         kept too (small, useful sim-time readout). Everything else from
         the full default (Shapes, Lights, TransformControl, Screenshot,
         CopyPaste, ComponentInspector, EntityTree, Spawn, SelectEntities,
         MarkerManager, CameraTracking, VisualizationCapabilities,
         EntityContextMenuPlugin) dropped -- editing tools this project
         doesn't use. -->
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <!-- Real request, 2026-08-26: aim the default GUI camera at
             cavex_tracked_blueboat's Home spawn (-88.78 -31.4 6.65, see
             gazebo_tracked_vehicle.launch.py's own spawn_bluerov2 args --
             no -Y arg given there, so it spawns at yaw=0, nose toward
             +X, meaning its rear/stern faces -X) so the boat's rear is
             framed on load instead of the old generic near-origin
             overview above. Camera sits 8m further out along -X (behind
             the stern) and 3m above hull height, yaw=0 (facing +X, i.e.
             toward the boat) with a mild downward pitch. -->
        <camera_pose>-96.78 -31.4 9.65 0 0.3 0</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <!-- Re-added after being trimmed out with the other clutter -- needed
           for follow-mode: exposes the real /gui/follow (gz.msgs.StringMsg
           -> gz.msgs.Boolean) and /gui/follow/offset services, confirmed via
           `strings` on the installed libCameraTracking.so, not guessed. -->
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <!-- Real request, 2026-08-26: the WorldControl panel (play/pause/step
           the simulation itself -- gz-sim8's default orange-accented
           buttons) removed from the GUI. The sim still starts running
           normally (nothing here changes start_paused behavior at the
           world level, that was WorldControl's own UI-only setting);
           there's just no on-screen control to pause/step it any more. -->
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <!-- Real request, 2026-08-26: GUI controls for the tracked vehicle,
           ported from perception branch's InfoLabel/ManualControl (see
           cavex_tracked_vehicle_gui, built from that package's own
           pattern) and adapted for a ground vehicle -- discrete
           track/rover commands instead of numeric current/turbidity
           readouts, turn-left/turn-right instead of a depth axis. Both
           plugin types only speak gz-transport; manual_gui_bridge.py
           (cavex_tracked_vehicle, auto-launched by
           gazebo_tracked_vehicle.launch.py) is what actually drives
           /cmd_vel and republishes the ActionButtons commands onto the
           real ROS2 topics vehicle_switch_node.py/
           track_retract_control.py already consume. -->
      <plugin filename="ActionButtons" name="Track control">
        <gz-gui>
          <title>Track control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">170</property>
          <property type="double" key="height">34</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="horizontalCenter" target="horizontalCenter"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <label>Track</label>
        <button1_label>up</button1_label>
        <button1_cmd>retracted</button1_cmd>
        <button2_label>down</button2_label>
        <button2_cmd>deployed</button2_cmd>
        <topic>/cavex/track_cmd</topic>
      </plugin>
      <!-- Real request, 2026-08-26: the "Rover lock control" ActionButtons
           panel (Lock/Unlock) that used to sit here was removed -- there
           is no longer a separate BlueROV2 entity to lock/unlock,
           bluerov2 is now a fixed child link of this same boat model.
           See perception branch for the full, functional, lockable
           BlueROV2. -->
      <!-- Manual drive D-pad (left/fwd/right/rev + center stop) --
           top-left, the only free corner (bottom two are the
           ActionButtons + World control/stats). Publishes to
           /cavex/manual_cmd; only actually moves the vehicle while
           manual_gui_bridge.py is running AND the Manual toggle (on the
           turn panel below) is on. -->
      <plugin filename="ManualControl" name="Manual control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">150</property>
          <property type="double" key="height">96</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
        <mode>dpad</mode>
      </plugin>
      <!-- Speed up/down + the Manual toggle -- top-right. Real request,
           2026-08-26: replaces this panel's earlier turn-left/turn-right
           pair (the D-pad's own left/right buttons already turn the
           vehicle -- see "Manual control" above -- so this panel is
           free for speed adjustment instead of duplicating that). -->
      <plugin filename="ManualControl" name="Manual speed control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">100</property>
          <property type="double" key="height">96</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
        <mode>speed</mode>
      </plugin>
    </gui>
    <physics name="4ms" type="bullet">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <!-- Real bug fixed 2026-08-28: engine switched ODE -> bullet-
           featherstone (see the Physics system plugin below). Two hard
           facts found via `gz sim -v4`:
           (1) gz-sim Harmonic ships NO ODE engine plugin, so <physics
               type="ode"> silently ran on dartsim -- the old <ode><solver>
               <iters>200</iters> block here was a dead no-op the whole
               time.
           (2) dartsim cannot build collision from an SDF <mesh> ("Mesh
               construction from an SDF has not been implemented yet for
               dartsim"), so cave_world's mesh collision AND the boat's
               blueboat_hull_collision.stl had NO collision body -- the
               vehicle was floating/resting on primitive boxes only.
           bullet-featherstone loads both mesh collisions with no error,
           and RTF on this world went 0.014 -> ~0.98 (the "RTF collapse"
           this comment used to blame on ODE solver iters was really
           dartsim struggling with this world). -->
    </physics>

    <!-- Ported from Gazebo Classic (gzserver/gazebo_ros) to Gazebo Harmonic
         (gz-sim). Adding any explicit <plugin> disables gz-sim's implicit
         default plugin set, so everything needed has to be listed here.
         <engine><filename> selects the physics engine (equivalent to
         `gz sim --physics-engine ...`). -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- Real gz-sim world-scoped wrench-application system (confirmed via
         `strings` on the installed .so: subscribes gz.msgs.EntityWrench on
         /world/<world>/wrench, /wrench/persistent, /wrench/clear -- same
         verification discipline as every other plugin in this project).
         Used by motorized_tether_control.py to apply a real spring-damper
         corrective force pulling the tethered BlueROV2 back within the
         current commanded tether length -- there is no rope/cable physics
         system installed in this Gazebo Harmonic build (confirmed absent
         from /usr/lib/x86_64-linux-gnu/gz-sim-8/plugins/), so this force-based
         constraint is the real, honest mechanism available, not a claim of
         simulated cable dynamics (no catenary droop/self-collision). -->
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench" />

    <!-- World-level gz-sim-buoyancy-system (graded_buoyancy, above_depth 6.0)
         was REMOVED 2026-08-28. In graded_buoyancy mode it ignores its
         <enable> list and buoys every model, so it silently lifted the
         boat and overpowered boat_buoyancy_control.py (node commanding
         37 N of lift against a 466 N weight, boat still pinned high),
         making the 6-12cm float target and the 3m basin depth
         unreachable. Nothing in this branch needs it: the boat has
         boat_buoyancy_control.py (via gz-sim-apply-link-wrench-system
         above), bluerov2 is a fixed child link of the boat, x500 is inert
         deck cargo. If an independent thruster-driven bluerov2 is ever
         respawned, give it a model-level Hydrodynamics/Buoyancy of its own. -->


    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Safety-net plane only, far below all real geometry -- NOT meant to be
         anything a vehicle ever rests on. Real history: earlier versions of
         this world left this at z=0, and every "the robot is standing on the
         cave floor" check up to that point (Task 8's original probe-drop
         test, and an entire probe-drop survey session that re-derived the
         water region) was actually resting on THIS flat plane, not real cave
         mesh collision -- the vendored cave_world.obj's collision mesh has
         real, confirmed gaps directly underfoot in large areas (e.g. a probe
         dropped at the original x=-60,y=0 dry-section spawn point fell
         completely through, with ZERO mesh vertices found within a 6x6m
         window there -- a genuine hole in the scan, not a measurement error).
         Moved far below (z=-200) so nothing can be mistaken for resting on
         real cave floor again; the real supplementary floor collision is now
         the cavex_floor_seal mesh in models/cave_world/. -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -200 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>300 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>300 200</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Real cave geometry: vendored from LTU-RAI/gazebo_cave_world (MIT).
         Koval, Kanellakis, Vidmark, Haluska, Nikolakopoulos, "A Subterranean
         Virtual Cave World for Gazebo based on the DARPA SubT Challenge",
         arXiv:2004.08452, Lulea University of Technology. Not authored here.
         Pose computed by Task 8's AABB script from the real OBJ vertices --
         NOT just a Z-axis yaw as originally planned: this OBJ's local up
         axis is Y, not Z (cross-checked against upstream's own
         worlds/cave_world.world, which itself applies roll=90 deg to stand
         the mesh up), so roll=pi/2 fixes local-Y-up -> world-Z-up and an
         additional yaw=pi/2 puts the ~150m long axis on world X.
         Real, measured world-frame bounds after this pose: x [-75.17,75.17],
         y [-51.16,51.16], z [0,36.18] (height is 36.18m, not the nominal
         33m -- >1m off nominal; x/y match nominal within ~0.2m). -->
    <!-- Scaled 2x by real request (persistent tight-corridor stuck issues --
         testing whether a proportionally larger cave gives real working
         room). <scale> as a direct child of <include> does NOT work in this
         installed sdformat/gz-sim version -- confirmed live: it produced a
         real "XML Element[scale] ... not defined in SDF" parser warning
         (same class as this session's other confirmed-real SDF bugs, not a
         harmless vendor-extension warning), and the vehicle's spawn height
         came out pixel-identical to every prior unscaled run, proving it was
         silently ignored. The real, working mechanism is <scale> inside
         <mesh> geometry (models/cave_world/model.sdf's own collision+visual
         mesh elements) -- see that file for the actual scale. Scaling
         happens around the mesh's local origin, NOT around the vehicle
         spawn -- that keeps its original
         absolute position, so the actual corridor geometry at any given
         world position shifts, not just widens in place. Live
         re-verification of spawn/floor alignment against the now-doubled
         mesh is required after this change, same as every other floor/water
         derivation in this file. -->
    <include>
      <uri>model://cave_world</uri>
      <name>cave_world</name>
      <pose>18.7830 31.4050 5.9826 1.5708 0.0000 1.5708</pose>
    </include>

    <!-- 2026-08-29: cave_floor_patch (and cave_floor_patch_scaled /
         cave_floor_patch_bridge, further below) REMOVED. Their job --
         supplementary floor collision over the vendored mesh's real gaps --
         is now done by the "cavex_floor_seal" triangle sheet baked into
         models/cave_world/meshes/cave_world_holed.obj (generated by that
         directory's tools/add_floor_seal.py). The seal is draped a few cm
         under the real mesh floor across:
           - drive corridor          world x[-43,68]  y[-13,13]
           - 2x-scale spawn area     world x[-122,-58] y[-48,-15]  (spawn ~ -88.78,-31.4)
           - spawn -> approach link  world x[-64,-36]  y[-48,14]
         The flooded-basin void x[0,32] is left open so the basin keeps its
         depth. Re-run add_floor_seal.py to retune; `git checkout
         cave_world_holed.obj` reverts. vehicle_switch_node.py's DRY_BOXES
         still carries these same world-frame rectangles for its
         shore-distance state machine -- that logic is coordinate-based, not
         model-queried, so the model removal does not affect it. -->

    <!-- 2026-08-30: the box `water_entry_ramp` model is GONE. Every box
         variant (long/short, pitched, riser, re-anchored) left a collision
         wall at the ramp/cave-floor seam that the tracks caught on and
         tumbled over. The wet/dry transition is now GRADED INTO THE CAVE
         MESH ITSELF -- a triangulated sheet welded flush to the cave floor
         at z=5.98 (x<=0) and grading down ~7 deg to z=5.0 at x=8, then the
         circular basin void resumes as open water. Generated by
         models/cave_world/meshes/tools/grade_water_ramp.py, baked into both
         cave_world_holed.obj (collision) and cave_world_visual.obj between
         `# >>> water_grade >>>` markers. Being mesh-continuous with the
         floor, there is no box end-face to hit. Water surface is at 5.98
         (= cave-floor level), so the vehicle floats off the graded sheet
         directly. -->



    <!-- 2026-08-29: the cave_floor_patch_north_wall / _south_wall boxes
         added earlier today (when the mesh collision was briefly disabled)
         were REMOVED again by real request -- the cave_world mesh collision
         is back on, so its own walls are the drive-area boundary; the box
         walls only got in the vehicle's way. -->

    <!-- 2026-08-29: cave_entry_ramp REMOVED. With water_surface at the
         cave-floor level (z=6.0) there is no step to bridge on the cave
         side -- the vehicle drives straight from the cave floor onto the
         water. This flat box just fills fall-through gaps in the vendored
         cave mesh across the x[-10,5] transition (same role as the
         cave_floor_patch hole-fills), top at z=5.2, ~0.8 m below the mesh
         floor so it only catches what drops through a real hole. -->


    <!-- 2026-08-29: cave_floor_patch_scaled (was x[-120,-60] y[-46,-17], the
         2x-mesh-scale spawn area at world ~-88.78,-31.4) and
         cave_floor_patch_bridge (was x[-62,-38] y[-46,12], the spawn ->
         water-approach link -- its y-path was never independently driven, so
         it was kept deliberately wide) were REMOVED together with
         cave_floor_patch; see that note above. The cavex_floor_seal mesh
         sheet in cave_world_holed.obj now covers the same two footprints,
         draped onto the real mesh floor where one exists and flat (~z=5.9)
         over the gaps. -->

    <!-- Real request 2026-08-28: plain flat-bottom basin (a parallelepiped),
         floor top z=3.0 across the whole x[5,40] y[-12,25] water_surface
         footprint. Surface z=7.0 -> a uniform 4m water column. The dry
         approach descends into it via cave_entry_ramp (x[-10,5], 5.9->3.0),
         whose deep end meets this floor flush at x=5. -->
    <!-- 2026-08-29: west edge x=0 -> x=-2 to underlie the widened
         water_surface and the foot of water_entry_ramp. size_x 40 -> 42,
         center_x 20 -> 19. -->
    <!-- 2026-08-29: water_entry_shelf REMOVED (real request). It was a shallow
         box at x[-2,6] z top 5.5 bridging the water_entry_ramp foot to
         basin_floor so a track-driven vehicle wouldn't nose off the ramp lip
         into the 2.8 m basin drop. If ramp->basin entry cartwheels again,
         that's the reason -- restore from git history. -->
    <!-- 2026-08-30: safety net under the whole trimmed play box. The
         vendored cave mesh has floor gaps; ground_plane sits at z=-200, so a
         fall through one drops the vehicle 200 m (seen live: z=-199.6). This
         invisible box sits ~1.5 m below the cave floor (~5.9): a fall is now
         <=1.5 m onto solid collision instead of into the void. cap_open_edges.py
         seals the vertical corridor mouths; this catches horizontal gaps. -->
    <model name="play_floor">
      <static>true</static>
      <pose>-45 -15 4.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>200 110 1</size></box></geometry>
          <surface>
            <contact><ode><max_vel>1.0</max_vel></ode></contact>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Manually-placed vertical corridor caps. Each is a thin box slab
         perpendicular to the cave floor, dropped where the vehicle reached
         an open mesh corridor mouth during manual driving. size = (thickness,
         width, height); yaw aligns the thin axis with the corridor. -->
    <model name="cap_plate_1">   <!-- open corridor S of (-103.6,-58.5), heading -82.6 deg.
         2026-08-31: y -60.2 -> -59.3 (was ~0.9 m past the mesh floor edge, so
         the vehicle nosed into the gap, tilted over the edge and wedged);
         also 10x14 -> 12x16 and z-centre 12.0 -> 11.5 (bottom well under the
         dipped ~5.4 floor here). -->
      <static>true</static>
      <pose>-103.4 -59.3 11.5 0 0 -1.442</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 12 16</size></box></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 12 16</size></box></geometry>
          <material><ambient>0.30 0.26 0.22 1</ambient><diffuse>0.30 0.26 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cap_plate_2">   <!-- open corridor W of (-121.7,-34.2), heading 177 deg -->
      <static>true</static>
      <pose>-123.4 -34.1 12.4 0 0 3.091</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 10 14</size></box></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 10 14</size></box></geometry>
          <material><ambient>0.30 0.26 0.22 1</ambient><diffuse>0.30 0.26 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cap_plate_3">   <!-- open corridor W of (-128.5,5.2), heading 180 deg.
         2026-08-31: x -130.15 -> -126.85 (was ~3.1 m past the trimmed mesh
         floor edge, same fall-through as cap_plate_1); width 10 -> 12. -->
      <static>true</static>
      <pose>-126.85 5.23 12.4 0 0 3.140</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 12 14</size></box></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 12 14</size></box></geometry>
          <material><ambient>0.30 0.26 0.22 1</ambient><diffuse>0.30 0.26 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cap_plate_4">   <!-- open corridor S of (-65.1,-52.8), heading -90 deg -->
      <static>true</static>
      <pose>-65.12 -54.51 12.4 0 0 -1.568</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 10 14</size></box></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
