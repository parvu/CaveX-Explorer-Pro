<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="cavex_world">
    <physics name="4ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <!-- Raised ODE solver iterations 50 (gz-sim default) -> 200: the
           tracked vehicle's track collision boxes need real anisotropic
           friction (mu2=50+, see model.sdf.tracked's own track collision
           comment) to convert commanded track speed into correct real
           speed, not just correct direction -- but at the gz-sim default
           iteration count, any mu2 above ~5-10 caused real, measured RTF
           collapse (0.6+ -> ~0.09) on this world's dense, irregular cave-
           floor mesh (box-vs-uneven-mesh contact at high friction is a
           known ODE solver stiffness source; the gz-sim reference
           tracked-vehicle example that uses mu2=150 successfully runs on
           a flat <plane> ground, not a mesh like this one). More solver
           iterations per step is the standard fix for exactly this
           class of stiff-contact convergence problem. -->
      <ode>
        <solver>
          <iters>200</iters>
        </solver>
      </ode>
    </physics>

    <!-- Ported from Gazebo Classic (gzserver/gazebo_ros) to Gazebo Harmonic
         (gz-sim). Adding any explicit <plugin> disables gz-sim's implicit
         default plugin set, so everything needed has to be listed here. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- Real gz-sim world-scoped wrench-application system (confirmed via
         `strings` on the installed .so: subscribes gz.msgs.EntityWrench on
         /world/<world>/wrench, /wrench/persistent, /wrench/clear -- same
         verification discipline as every other plugin in this project).
         Used by motorized_tether_control.py to apply a real spring-damper
         corrective force pulling the tethered BlueROV2 back within the
         current commanded tether length -- there is no rope/cable physics
         system installed in this Gazebo Harmonic build (confirmed absent
         from /usr/lib/x86_64-linux-gnu/gz-sim-8/plugins/), so this force-based
         constraint is the real, honest mechanism available, not a claim of
         simulated cable dynamics (no catenary droop/self-collision). -->
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench" />

    <!-- Buoyancy plugin: vendored from clydemcqueen/bluerov2_gz's
         worlds/bluerov2_underwater.world (real upstream structure, not
         guessed -- the bluerov2 model.sdf itself has no Buoyancy plugin,
         only Hydrodynamics + 6 Thruster plugins; Buoyancy is a world-level
         plugin in the real upstream repo). above_depth is relative to
         world-frame z=0, so it tracks CAVE_FLOOR_Z + 2.0 (see
         cave_floor_patch's own comment for how CAVE_FLOOR_Z=5.9 was
         derived) -- a 2m partial flood above the real cave floor, not a
         guessed height. -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>7.9</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <!-- Must match the SPAWN-TIME ENTITY NAME exactly, not just the model's internal
           SDF <model name>. gz-sim-buoyancy-system matches <enable> against the entity
           name given at spawn (e.g. the `name:` argument to `gz service .../create`),
           not the model file's own <model name="bluerov2">. Spawning with any other
           entity name (e.g. "bluerov2_test") makes Buoyancy silently no-op -- no error,
           the vehicle just sinks/rests on the floor as if unbuoyant. Confirmed the hard
           way: Task 16's own live verification test hit exactly this and produced a
           false pass (settled on ground_plane, not actual mid-water equilibrium) until
           re-run with the correctly-matching entity name "bluerov2". -->
      <enable>bluerov2</enable>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Safety-net plane only, far below all real geometry -- NOT meant to be
         anything a vehicle ever rests on. Real history: earlier versions of
         this world left this at z=0, and every "the robot is standing on the
         cave floor" check up to that point (Task 8's original probe-drop
         test, and an entire probe-drop survey session that re-derived the
         water region) was actually resting on THIS flat plane, not real cave
         mesh collision -- the vendored cave_world.obj's collision mesh has
         real, confirmed gaps directly underfoot in large areas (e.g. a probe
         dropped at the original x=-60,y=0 dry-section spawn point fell
         completely through, with ZERO mesh vertices found within a 6x6m
         window there -- a genuine hole in the scan, not a measurement error).
         Moved far below (z=-200) so nothing can be mistaken for resting on
         real cave floor again; see cave_floor_patch below for the actual,
         real supplementary floor collision. -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -200 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Real cave geometry: vendored from LTU-RAI/gazebo_cave_world (MIT).
         Koval, Kanellakis, Vidmark, Haluska, Nikolakopoulos, "A Subterranean
         Virtual Cave World for Gazebo based on the DARPA SubT Challenge",
         arXiv:2004.08452, Lulea University of Technology. Not authored here.
         Pose computed by Task 8's AABB script from the real OBJ vertices --
         NOT just a Z-axis yaw as originally planned: this OBJ's local up
         axis is Y, not Z (cross-checked against upstream's own
         worlds/cave_world.world, which itself applies roll=90 deg to stand
         the mesh up), so roll=pi/2 fixes local-Y-up -> world-Z-up and an
         additional yaw=pi/2 puts the ~150m long axis on world X.
         Real, measured world-frame bounds after this pose: x [-75.17,75.17],
         y [-51.16,51.16], z [0,36.18] (height is 36.18m, not the nominal
         33m -- >1m off nominal; x/y match nominal within ~0.2m). -->
    <!-- Scaled 2x by real request (persistent tight-corridor stuck issues --
         testing whether a proportionally larger cave gives real working
         room). <scale> as a direct child of <include> does NOT work in this
         installed sdformat/gz-sim version -- confirmed live: it produced a
         real "XML Element[scale] ... not defined in SDF" parser warning
         (same class as this session's other confirmed-real SDF bugs, not a
         harmless vendor-extension warning), and the vehicle's spawn height
         came out pixel-identical to every prior unscaled run, proving it was
         silently ignored. The real, working mechanism is <scale> inside
         <mesh> geometry (models/cave_world/model.sdf's own collision+visual
         mesh elements) -- see that file for the actual scale. Scaling
         happens around the mesh's local origin, NOT around the vehicle
         spawn or cave_floor_patch below -- those keep their original
         absolute positions, so the actual corridor geometry at any given
         world position shifts, not just widens in place. Live
         re-verification of spawn/floor alignment against the now-doubled
         mesh is required after this change, same as every other floor/water
         derivation in this file. -->
    <include>
      <uri>model://cave_world</uri>
      <name>cave_world</name>
      <pose>18.7830 31.4050 5.9826 1.5708 0.0000 1.5708</pose>
    </include>

    <!-- Supplementary floor collision -- NOT part of the vendored mesh (that
         stays unmodified). Added because the vendored mesh's own collision
         has real, confirmed gaps in floor coverage across large areas
         (see ground_plane's comment above for how this was discovered).
         CAVE_FLOOR_Z=5.9 was derived directly from the mesh's own visual
         vertex data (not from any probe-drop test, which the discovery
         above showed was unreliable): parsing cave_world.obj's raw
         vertices and transforming them into world frame with the same
         pose as the cave_world include above, the x range [-37, 65]
         (the corridor this project actually uses, dry section through the
         flooded chamber) shows a remarkably consistent real floor height
         clustered tightly around z=5.5-6.1 across dozens of independent
         2m x-slices (e.g. x=-37: 5.98; x=27: 5.56 (2324 verts); x=57: 5.90
         (5228 verts) -- these are genuine, dense mesh regions, not sparse
         guesses). This patch covers x [-40,70] y [-12,12] at a flat
         top surface z=5.9 (box center z=5.4, thickness 1m) -- a flat
         proxy for the real, gently-undulating visual floor in that
         height cluster, not a perfect match to every bump, but grounded
         in real mesh data rather than an arbitrary guess. The vehicle
         spawn, obstacle positions, and water region below were all moved
         to sit on this patch. x < -40 (the original x=-60 spawn area) is
         NOT covered -- that area's mesh has real floor-coverage gaps and
         was abandoned rather than patched further given time already
         invested; if resuming work there, redo the vertex-density check
         from this comment before trusting anything in that zone. -->
    <model name="cave_floor_patch">
      <static>true</static>
      <pose>15 0 5.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>110 24 1</size></box></geometry>
          <surface>
            <contact><ode><max_vel>0.01</max_vel></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>110 24 1</size></box></geometry>
          <material><ambient>0.25 0.22 0.2 1</ambient><diffuse>0.25 0.22 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Second floor patch for the cave_world 2x mesh scale (real request --
         see model.sdf.tracked -- err, models/cave_world/model.sdf's own
         comment for the scale itself, and gazebo_tracked_vehicle.launch.py's
         spawn_entity comment for the full re-derivation). The mesh scale is
         a global rigid+uniform transform around the cave_world include's own
         local origin, not around cave_floor_patch above -- so the real
         corridor (and the vehicle spawn moved to follow it) is now at
         world x~-88.78 y~-31.4, nowhere near this patch's x[-40,70] y[-12,12]
         coverage. Precisely computed (not guessed): inverted the SDF pose's
         rotation+translation to get the documented x=-37 floor point's real
         LOCAL mesh coordinate, re-applied the same transform with scale=2 ->
         real floor at world (-92.78, -31.4, ~5.98), i.e. barely different in
         z from the original ~5.9 (the pose's own z, 5.9826, sits almost
         exactly at floor height, so points near the floor barely move in z
         under scaling around it). This patch covers x [-120,-60] y [-46,-17]
         at top surface z=5.9 (box center z=5.4, matching the original
         patch's own convention), generously sized around the new spawn/
         corridor location for initial driving/testing -- not yet extended
         to cover the whole doubled corridor the way the original patch
         covers its own x[-40,70] stretch; widen this if testing moves
         further along the corridor and falls off the edge. -->
    <model name="cave_floor_patch_scaled">
      <static>true</static>
      <pose>-90 -31.4 5.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>60 29 1</size></box></geometry>
          <surface>
            <contact><ode><max_vel>0.01</max_vel></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>60 29 1</size></box></geometry>
          <material><ambient>0.25 0.22 0.2 1</ambient><diffuse>0.25 0.22 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- REAL BUG FOUND AND FIXED: cave_floor_patch_scaled above (x[-120,-60])
         and cave_floor_patch (x[-40,70]) never actually met -- confirmed
         live via physics probes dropped at x=-55/-50/-45, y=-25 (the
         corridor's own y near the new spawn): all three fell straight
         through to ground_plane's z=-200 safety net, proving there is no
         real collision at all in x[-60,-40], not just an untested gap as
         this file's own earlier comment suspected. This patch bridges it,
         same z=5.4/top=5.9 convention as its neighbors (justified there by
         real mesh-vertex data spanning both scale regimes). x[-62,-38]
         overlaps 2m into each neighbor so there's no seam gap at the
         boundary; y[-46,12] spans the full union of both neighbors' own
         y-coverage since the real corridor's y-path through this
         untested stretch isn't independently confirmed -- narrow this
         once that path is actually driven and verified, rather than
         trusting this wide a guess indefinitely. -->
    <model name="cave_floor_patch_bridge">
      <static>true</static>
      <pose>-50 -17 5.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24 58 1</size></box></geometry>
          <surface>
            <contact><ode><max_vel>0.01</max_vel></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>24 58 1</size></box></geometry>
          <material><ambient>0.25 0.22 0.2 1</ambient><diffuse>0.25 0.22 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- obstacle_1..4 (Fuel-sourced cinder blocks/barrel) removed by real
         request -- the dry-section corridor between the spawn (x=-35) and
         the water boundary (x=15) is now clear of Nav2 costmap/explore_lite
         obstacles. -->

    <!-- Flooded water region, re-anchored to cave_floor_patch's real
         CAVE_FLOOR_Z=5.9 (see that model's own comment for the full
         real-mesh-vertex derivation -- this world's earlier water-region
         history, including a "live probe-drop survey" that found a floor
         at z~=0, was itself resting on ground_plane by mistake; see
         ground_plane's own comment for that discovery). Water surface at
         z = CAVE_FLOOR_Z + 2.0 = 7.9 -- a real 2m partial flood above the
         actual cave floor. Region: x [15,65] y [-10,10], center (40, 0,
         7.9), plane size 50 x 20 (within cave_floor_patch's x [-40,70]
         y [-12,12] coverage, inset for margin). Task 19's water-boundary
         handoff should treat x=15 as the wet/dry boundary. -->
    <model name="water_surface">
      <static>true</static>
      <pose>40 0 7.9 0 0 0</pose>
      <link name="surface">
        <visual name="water_visual">
          <geometry><plane><size>50 20</size></plane></geometry>
          <material><diffuse>0.1 0.3 0.6 0.6</diffuse><ambient>0.1 0.3 0.6 0.6</ambient></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
