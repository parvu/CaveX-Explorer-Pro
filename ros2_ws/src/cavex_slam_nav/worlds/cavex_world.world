<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="cavex_world">
    <!-- Real gap found and fixed: this file had NO <gui> element at all,
         so every GUI launch fell back to gz-sim's generic default camera
         pose (-6 0 6 0 0.5 0) -- nowhere near this world's actual action
         (the cave mesh itself sits far from world origin, per the
         cave_world include's own pose below, and every spawn point used in
         this project is out near x=20+ or x=-88). Confirmed as the real
         cause of "I don't see the ROV" complaints even when ground-truth
         pose showed it was really there and moving -- not a rendering bug,
         just an unaimed camera.

         First attempt at this fix used a bare <gui><camera> shorthand --
         wrong syntax, gz-sim logged "<gui><camera> can't be converted yet"
         and silently ignored the whole block (confirmed via a headless
         load check). The real, working mechanism is a <plugin
         filename="MinimalScene"> with a <camera_pose> child -- verified by
         reading the actual installed default GUI config
         (/usr/share/gz/gz-sim8/gui/gui.config, from the gz-sim8 apt
         package), not guessed.

         A second pass initially copied that default config's FULL plugin
         set (window chrome, world stats, entity tree, transform/
         screenshot/copy-paste tools, etc.) wholesale -- correct in
         principle (reuse tested upstream config over hand-rolling), but it
         crowded the window with floating toolbars nobody asked for. Pared
         down to the 4 plugins actually needed: MinimalScene (3D view, with
         the camera_pose fix), GzSceneManager (required -- this is what
         syncs simulated entities into the render scene at all, removing it
         would break visuals again), InteractiveViewControl (mouse
         drag/scroll camera control), WorldControl (play/pause). WorldStats
         kept too (small, useful sim-time readout). Everything else from
         the full default (Shapes, Lights, TransformControl, Screenshot,
         CopyPaste, ComponentInspector, EntityTree, Spawn, SelectEntities,
         MarkerManager, CameraTracking, VisualizationCapabilities,
         EntityContextMenuPlugin) dropped -- editing tools this project
         doesn't use. -->
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <!-- Real request, 2026-08-26: aim the default GUI camera at
             cavex_tracked_blueboat's Home spawn (-88.78 -31.4 6.65, see
             gazebo_tracked_vehicle.launch.py's own spawn_bluerov2 args --
             no -Y arg given there, so it spawns at yaw=0, nose toward
             +X, meaning its rear/stern faces -X) so the boat's rear is
             framed on load instead of the old generic near-origin
             overview above. Camera sits 8m further out along -X (behind
             the stern) and 3m above hull height, yaw=0 (facing +X, i.e.
             toward the boat) with a mild downward pitch. -->
        <camera_pose>-96.78 -31.4 9.65 0 0.3 0</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <!-- Re-added after being trimmed out with the other clutter -- needed
           for follow-mode: exposes the real /gui/follow (gz.msgs.StringMsg
           -> gz.msgs.Boolean) and /gui/follow/offset services, confirmed via
           `strings` on the installed libCameraTracking.so, not guessed. -->
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <!-- Real request, 2026-08-26: the WorldControl panel (play/pause/step
           the simulation itself -- gz-sim8's default orange-accented
           buttons) removed from the GUI. The sim still starts running
           normally (nothing here changes start_paused behavior at the
           world level, that was WorldControl's own UI-only setting);
           there's just no on-screen control to pause/step it any more. -->
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <!-- Real request, 2026-08-26: GUI controls for the tracked vehicle,
           ported from perception branch's InfoLabel/ManualControl (see
           cavex_tracked_vehicle_gui, built from that package's own
           pattern) and adapted for a ground vehicle -- discrete
           track/rover commands instead of numeric current/turbidity
           readouts, turn-left/turn-right instead of a depth axis. Both
           plugin types only speak gz-transport; manual_gui_bridge.py
           (cavex_tracked_vehicle, auto-launched by
           gazebo_tracked_vehicle.launch.py) is what actually drives
           /cmd_vel and republishes the ActionButtons commands onto the
           real ROS2 topics vehicle_switch_node.py/
           track_retract_control.py already consume. -->
      <plugin filename="ActionButtons" name="Track control">
        <gz-gui>
          <title>Track control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">170</property>
          <property type="double" key="height">34</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="horizontalCenter" target="horizontalCenter"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <label>Track</label>
        <button1_label>up</button1_label>
        <button1_cmd>retracted</button1_cmd>
        <button2_label>down</button2_label>
        <button2_cmd>deployed</button2_cmd>
        <topic>/cavex/track_cmd</topic>
      </plugin>
      <!-- Real request, 2026-08-26: the "Rover lock control" ActionButtons
           panel (Lock/Unlock) that used to sit here was removed -- there
           is no longer a separate BlueROV2 entity to lock/unlock,
           bluerov2 is now a fixed child link of this same boat model.
           See perception branch for the full, functional, lockable
           BlueROV2. -->
      <!-- Manual drive D-pad (left/fwd/right/rev + center stop) --
           top-left, the only free corner (bottom two are the
           ActionButtons + World control/stats). Publishes to
           /cavex/manual_cmd; only actually moves the vehicle while
           manual_gui_bridge.py is running AND the Manual toggle (on the
           turn panel below) is on. -->
      <plugin filename="ManualControl" name="Manual control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">150</property>
          <property type="double" key="height">96</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
        <mode>dpad</mode>
      </plugin>
      <!-- Speed up/down + the Manual toggle -- top-right. Real request,
           2026-08-26: replaces this panel's earlier turn-left/turn-right
           pair (the D-pad's own left/right buttons already turn the
           vehicle -- see "Manual control" above -- so this panel is
           free for speed adjustment instead of duplicating that). -->
      <plugin filename="ManualControl" name="Manual speed control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">100</property>
          <property type="double" key="height">96</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
        <mode>speed</mode>
      </plugin>
    </gui>
    <physics name="4ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <!-- Raised ODE solver iterations 50 (gz-sim default) -> 200: the
           tracked vehicle's track collision boxes need real anisotropic
           friction (mu2=50+, see model.sdf.tracked's own track collision
           comment) to convert commanded track speed into correct real
           speed, not just correct direction -- but at the gz-sim default
           iteration count, any mu2 above ~5-10 caused real, measured RTF
           collapse (0.6+ -> ~0.09) on this world's dense, irregular cave-
           floor mesh (box-vs-uneven-mesh contact at high friction is a
           known ODE solver stiffness source; the gz-sim reference
           tracked-vehicle example that uses mu2=150 successfully runs on
           a flat <plane> ground, not a mesh like this one). More solver
           iterations per step is the standard fix for exactly this
           class of stiff-contact convergence problem. -->
      <ode>
        <solver>
          <iters>200</iters>
        </solver>
      </ode>
    </physics>

    <!-- Ported from Gazebo Classic (gzserver/gazebo_ros) to Gazebo Harmonic
         (gz-sim). Adding any explicit <plugin> disables gz-sim's implicit
         default plugin set, so everything needed has to be listed here. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- Real gz-sim world-scoped wrench-application system (confirmed via
         `strings` on the installed .so: subscribes gz.msgs.EntityWrench on
         /world/<world>/wrench, /wrench/persistent, /wrench/clear -- same
         verification discipline as every other plugin in this project).
         Used by motorized_tether_control.py to apply a real spring-damper
         corrective force pulling the tethered BlueROV2 back within the
         current commanded tether length -- there is no rope/cable physics
         system installed in this Gazebo Harmonic build (confirmed absent
         from /usr/lib/x86_64-linux-gnu/gz-sim-8/plugins/), so this force-based
         constraint is the real, honest mechanism available, not a claim of
         simulated cable dynamics (no catenary droop/self-collision). -->
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench" />

    <!-- Buoyancy plugin: vendored from clydemcqueen/bluerov2_gz's
         worlds/bluerov2_underwater.world (real upstream structure, not
         guessed -- the bluerov2 model.sdf itself has no Buoyancy plugin,
         only Hydrodynamics + 6 Thruster plugins; Buoyancy is a world-level
         plugin in the real upstream repo). above_depth is relative to
         world-frame z=0, so it tracks CAVE_FLOOR_Z + 2.0 (see
         cave_floor_patch's own comment for how CAVE_FLOOR_Z=5.9 was
         derived) -- a 2m partial flood above the real cave floor, not a
         guessed height. -->
    <!-- Real request 2026-08-26: gz-sim-buoyancy-system's <enable> gates by entity
         name only -- <graded_buoyancy>/<above_depth> grades fluid density purely by
         world-frame Z height, with no concept of the water region's real X boundary
         (WATER_BOUNDARY_X=15.0, see vehicle_switch_node.py). Since the dry cave floor
         sits at roughly the same Z band as the flooded floor, enabling this for the
         boat lifted it even on dry land -- confirmed live, no way to region-gate it
         from this plugin's own config. It also computes lift through the hull
         collision mesh's own volume centroid, which isn't guaranteed to sit above the
         vehicle's real center of mass (bluerov2's fused hull + 6 thruster props add
         real off-axis mass -- see bluerov2_link below), so with no real righting
         moment the boat settled upside-down.
         Left disabled here (cavex_tracked_blueboat intentionally NOT in <enable>) and
         replaced by cavex_tracked_vehicle's boat_buoyancy_control.py, which applies
         an equivalent lift manually via gz-sim-apply-link-wrench-system below, gated
         on real live X position, and through a fixed above-CoM offset point that
         gives it a genuine righting torque when it heels. See that node's own
         docstring for the full story and the empirically-tuned target float height
         (Z~=7.2, surface at 7.9, floor at 5.9) this carries forward. -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <!-- Real request 2026-08-27: water region redesigned into a real
               3m-deep basin (surface z=6, floor z=3) instead of the old
               2m-deep shelf sitting on the real cave floor (surface z=7.9,
               floor z=5.9) -- see the basin/wall models below for the full
               story. This vehicle doesn't use this plugin directly (see
               boat_buoyancy_control.py), but bluerov2's own thruster-driven
               sub still would if ever spawned independently again, so kept
               in sync with the new surface height. -->
          <above_depth>6.0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Safety-net plane only, far below all real geometry -- NOT meant to be
         anything a vehicle ever rests on. Real history: earlier versions of
         this world left this at z=0, and every "the robot is standing on the
         cave floor" check up to that point (Task 8's original probe-drop
         test, and an entire probe-drop survey session that re-derived the
         water region) was actually resting on THIS flat plane, not real cave
         mesh collision -- the vendored cave_world.obj's collision mesh has
         real, confirmed gaps directly underfoot in large areas (e.g. a probe
         dropped at the original x=-60,y=0 dry-section spawn point fell
         completely through, with ZERO mesh vertices found within a 6x6m
         window there -- a genuine hole in the scan, not a measurement error).
         Moved far below (z=-200) so nothing can be mistaken for resting on
         real cave floor again; see cave_floor_patch below for the actual,
         real supplementary floor collision. -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -200 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Real cave geometry: vendored from LTU-RAI/gazebo_cave_world (MIT).
         Koval, Kanellakis, Vidmark, Haluska, Nikolakopoulos, "A Subterranean
         Virtual Cave World for Gazebo based on the DARPA SubT Challenge",
         arXiv:2004.08452, Lulea University of Technology. Not authored here.
         Pose computed by Task 8's AABB script from the real OBJ vertices --
         NOT just a Z-axis yaw as originally planned: this OBJ's local up
         axis is Y, not Z (cross-checked against upstream's own
         worlds/cave_world.world, which itself applies roll=90 deg to stand
         the mesh up), so roll=pi/2 fixes local-Y-up -> world-Z-up and an
         additional yaw=pi/2 puts the ~150m long axis on world X.
         Real, measured world-frame bounds after this pose: x [-75.17,75.17],
         y [-51.16,51.16], z [0,36.18] (height is 36.18m, not the nominal
         33m -- >1m off nominal; x/y match nominal within ~0.2m). -->
    <!-- Scaled 2x by real request (persistent tight-corridor stuck issues --
         testing whether a proportionally larger cave gives real working
         room). <scale> as a direct child of <include> does NOT work in this
         installed sdformat/gz-sim version -- confirmed live: it produced a
         real "XML Element[scale] ... not defined in SDF" parser warning
         (same class as this session's other confirmed-real SDF bugs, not a
         harmless vendor-extension warning), and the vehicle's spawn height
         came out pixel-identical to every prior unscaled run, proving it was
         silently ignored. The real, working mechanism is <scale> inside
         <mesh> geometry (models/cave_world/model.sdf's own collision+visual
         mesh elements) -- see that file for the actual scale. Scaling
         happens around the mesh's local origin, NOT around the vehicle
         spawn or cave_floor_patch below -- those keep their original
         absolute positions, so the actual corridor geometry at any given
         world position shifts, not just widens in place. Live
         re-verification of spawn/floor alignment against the now-doubled
         mesh is required after this change, same as every other floor/water
         derivation in this file. -->
    <include>
      <uri>model://cave_world</uri>
      <name>cave_world</name>
      <pose>18.7830 31.4050 5.9826 1.5708 0.0000 1.5708</pose>
    </include>

    <!-- Supplementary floor collision -- NOT part of the vendored mesh (that
         stays unmodified). Added because the vendored mesh's own collision
         has real, confirmed gaps in floor coverage across large areas
         (see ground_plane's comment above for how this was discovered).
         CAVE_FLOOR_Z=5.9 was derived directly from the mesh's own visual
         vertex data (not from any probe-drop test, which the discovery
         above showed was unreliable): parsing cave_world.obj's raw
         vertices and transforming them into world frame with the same
         pose as the cave_world include above, the x range [-37, 65]
         (the corridor this project actually uses, dry section through the
         flooded chamber) shows a remarkably consistent real floor height
         clustered tightly around z=5.5-6.1 across dozens of independent
         2m x-slices (e.g. x=-37: 5.98; x=27: 5.56 (2324 verts); x=57: 5.90
         (5228 verts) -- these are genuine, dense mesh regions, not sparse
         guesses). This patch covers x [-40,70] y [-12,12] at a flat
         top surface z=5.9 (box center z=5.4, thickness 1m) -- a flat
         proxy for the real, gently-undulating visual floor in that
         height cluster, not a perfect match to every bump, but grounded
         in real mesh data rather than an arbitrary guess. The vehicle
         spawn, obstacle positions, and water region below were all moved
         to sit on this patch. x < -40 (the original x=-60 spawn area) is
         NOT covered -- that area's mesh has real floor-coverage gaps and
         was abandoned rather than patched further given time already
         invested; if resuming work there, redo the vertex-density check
         from this comment before trusting anything in that zone. -->
    <model name="cave_floor_patch">
      <static>true</static>
      <pose>15 0 5.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>110 24 1</size></box></geometry>
          <surface>
            <contact><ode><max_vel>2.0</max_vel></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>110 24 1</size></box></geometry>
          <material><ambient>0.25 0.22 0.2 1</ambient><diffuse>0.25 0.22 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Second floor patch for the cave_world 2x mesh scale (real request --
         see model.sdf.tracked -- err, models/cave_world/model.sdf's own
         comment for the scale itself, and gazebo_tracked_vehicle.launch.py's
         spawn_entity comment for the full re-derivation). The mesh scale is
         a global rigid+uniform transform around the cave_world include's own
         local origin, not around cave_floor_patch above -- so the real
         corridor (and the vehicle spawn moved to follow it) is now at
         world x~-88.78 y~-31.4, nowhere near this patch's x[-40,70] y[-12,12]
         coverage. Precisely computed (not guessed): inverted the SDF pose's
         rotation+translation to get the documented x=-37 floor point's real
         LOCAL mesh coordinate, re-applied the same transform with scale=2 ->
         real floor at world (-92.78, -31.4, ~5.98), i.e. barely different in
         z from the original ~5.9 (the pose's own z, 5.9826, sits almost
         exactly at floor height, so points near the floor barely move in z
         under scaling around it). This patch covers x [-120,-60] y [-46,-17]
         at top surface z=5.9 (box center z=5.4, matching the original
         patch's own convention), generously sized around the new spawn/
         corridor location for initial driving/testing -- not yet extended
         to cover the whole doubled corridor the way the original patch
         covers its own x[-40,70] stretch; widen this if testing moves
         further along the corridor and falls off the edge. -->
    <model name="cave_floor_patch_scaled">
      <static>true</static>
      <pose>-90 -31.4 5.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>60 29 1</size></box></geometry>
          <surface>
            <contact><ode><max_vel>2.0</max_vel></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>60 29 1</size></box></geometry>
          <material><ambient>0.25 0.22 0.2 1</ambient><diffuse>0.25 0.22 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- REAL BUG FOUND AND FIXED: cave_floor_patch_scaled above (x[-120,-60])
         and cave_floor_patch (x[-40,70]) never actually met -- confirmed
         live via physics probes dropped at x=-55/-50/-45, y=-25 (the
         corridor's own y near the new spawn): all three fell straight
         through to ground_plane's z=-200 safety net, proving there is no
         real collision at all in x[-60,-40], not just an untested gap as
         this file's own earlier comment suspected. This patch bridges it,
         same z=5.4/top=5.9 convention as its neighbors (justified there by
         real mesh-vertex data spanning both scale regimes). x[-62,-38]
         overlaps 2m into each neighbor so there's no seam gap at the
         boundary; y[-46,12] spans the full union of both neighbors' own
         y-coverage since the real corridor's y-path through this
         untested stretch isn't independently confirmed -- narrow this
         once that path is actually driven and verified, rather than
         trusting this wide a guess indefinitely. -->
    <model name="cave_floor_patch_bridge">
      <static>true</static>
      <pose>-50 -17 5.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24 58 1</size></box></geometry>
          <surface>
            <contact><ode><max_vel>2.0</max_vel></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>24 58 1</size></box></geometry>
          <material><ambient>0.25 0.22 0.2 1</ambient><diffuse>0.25 0.22 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Real request 2026-08-27: water region redesigned into a real 3m-deep
         basin (surface z=6, floor z=3) instead of the old 2m-deep shelf
         sitting on the unmodified real cave floor (surface z=7.9,
         floor z=5.9). Replaces the old two-ramp system below (shoreline_ramp
         climbing UP from the dry floor to a shelf edge, water_entry_ramp
         diving back DOWN into shallow water at the same z=5.9 floor) --
         that whole shape only made sense for a shallow shelf, not a basin.

         Single entry_ramp now carries the real floor smoothly from the
         confirmed dry-floor anchor (x=15, z=5.9 -- same point this file's
         own water-boundary history already validated has real cave mesh,
         see the water region's own comment above) down to the new basin
         floor (x=30, z=3) below. x [5,15] stays on cave_floor_patch's own
         existing flat z=5.9 top -- already real synthetic-floor collision,
         nothing new needed there -- giving a genuinely shallow (surface
         z=6, floor z=5.9: 0.1m) entry right at the water's new west edge
         (x=5, WATER_BOUNDARY_X in boat_buoyancy_control.py/
         vehicle_switch_node.py) that gets smoothly deeper along the ramp,
         not an abrupt step. Real request acknowledged this region (x<15)
         has no real cave MESH geometry -- confirmed void, see the water
         region comment's own live vertex-proximity check -- so it will
         look like driving/floating in open space with no walls or ceiling
         visible; only the synthetic floor collision is real here, not the
         visuals.

         Pitch = atan2(rise, run) = atan2(-2.9, 15) = -0.1910 rad
         (-10.94 deg); box center offset from the top-surface midpoint by
         Ry(pitch) @ (0,0,-thickness/2), same method (and same live corner-
         check) as the two ramps this replaces. Top-surface corners land at
         (15.19, 5.90) and (30.19, 3.00) -- the far end deliberately
         overlaps 0.19m into basin_floor below, same "overlap so there's no
         seam gap" convention as cave_floor_patch_bridge. -->
    <model name="entry_ramp">
      <static>true</static>
      <pose>22.5949 6.5 3.9591 0 -0.1910 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>15.2778 37 1</size></box></geometry>
          <surface>
            <contact><ode><max_vel>2.0</max_vel></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>15.2778 37 1</size></box></geometry>
          <material><ambient>0.2 0.22 0.28 1</ambient><diffuse>0.2 0.22 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Basin floor: the new 3m-deep basin's real bottom (z=3), since
         cave_floor_patch's own collision box only goes down to z=4.9 (top
         5.9, thickness 1) -- below that, nothing until ground_plane's
         z=-200 safety net. Starts at x=28 (2m overlap into entry_ramp's own
         far/bottom end at x=30.19, same seam convention) and runs to x=70,
         the water box's real east edge (east_boundary_wall). Spans the
         full y[-12,25] water width. -->
    <model name="basin_floor">
      <static>true</static>
      <pose>49 6.5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>42 37 1</size></box></geometry>
          <surface>
            <contact><ode><max_vel>2.0</max_vel></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>42 37 1</size></box></geometry>
          <material><ambient>0.15 0.17 0.22 1</ambient><diffuse>0.15 0.17 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- obstacle_1..4 (Fuel-sourced cinder blocks/barrel) removed by real
         request -- the dry-section corridor between the spawn (x=-35) and
         the water boundary (x=15) is now clear of Nav2 costmap/explore_lite
         obstacles. -->

    <!-- Flooded water region, re-anchored to cave_floor_patch's real
         CAVE_FLOOR_Z=5.9 (see that model's own comment for the full
         real-mesh-vertex derivation -- this world's earlier water-region
         history, including a "live probe-drop survey" that found a floor
         at z~=0, was itself resting on ground_plane by mistake; see
         ground_plane's own comment for that discovery). Water surface at
         z = CAVE_FLOOR_Z + 2.0 = 7.9 -- a real 2m partial flood above the
         actual cave floor.

         SHRUNK from the earlier x [15,65] y [-10,10]: that region was only
         checked against the synthetic cave_floor_patch collision box, never
         the real mesh. Direct mesh-vertex inspection (same transform as
         CAVE_FLOOR_Z's own derivation: cave_world.obj vertices x2 scale,
         then the cave_world include's pose) found the floor-height vertex
         cluster near y=0 holds together through x~=15-40 (consistent with
         cave_floor_patch's trusted y [-12,12] and its own validated floor
         points at x=27, x=57), but a completely different, disconnected
         floor-height cluster appears at y~=-27..-40 for x>=40 -- a separate
         chamber/branch, not a continuation of this corridor by any simple
         coordinate measure. x>=35 is unverified territory for water
         placement; re-derive properly (real mesh connected-component
         analysis, not vertex-coordinate clustering) before extending the
         flood further that direction.

         EXTENDED to x=0, then REVERTED: extending to x=0 was flagged at the
         time as unverified (x [0,15] had almost no floor-height mesh data),
         and live-testing confirmed it was actually wrong, not just
         unverified -- checked mesh proximity directly (any vertex within 3m
         xy, any z) at several candidates: x=1 and x=10 have ZERO nearby
         mesh vertices at any height (a real void, not sparse coverage of
         real space), while x=15 has real geometry including a z=5.98 floor
         vertex matching CAVE_FLOOR_Z. The vehicle spawned there visually
         vanished ("spawned in a hole") -- consistent with a void, not a
         rendering gap over real floor. Region restored to x [15,35]
         y [-10,10], center (25, 0, 7.9), plane size 20 x 20 -- back inside
         the one cluster actually confirmed to hold real cave geometry.
         x<15 is now confirmed void, not just unverified; do not extend the
         water there again without first confirming real mesh geometry
         exists (proximity check, not just floor-height clustering, since
         clustering alone can't distinguish "sparse real corridor" from "no
         mesh at all"). x>=35 remains unverified territory per the entry
         above (chamber-vs-corridor ambiguity, not a confirmed void).
         Task 19's water-boundary handoff treats x=15 as the wet/dry
         boundary -- restored to matching the water's own edge again.

         Y EXTENDED to [-12,12]: tried deriving real wall positions from
         raw mesh-vertex clustering at 1m x-resolution across x [15,35] --
         too sparse/noisy to trust (many slices had 1-3 stray vertices, no
         coherent signal; this is the same class of unreliable-clustering
         mistake that caused the x=0 void, not repeated a third time by
         treating noisy output as fact). Instead of a third vertex-derived
         guess, reused cave_floor_patch's own y [-12,12] -- the SAME
         synthetic-patch philosophy already applied to that model (a flat
         proxy grounded in real mesh data at specific validated points, not
         a perfect match to every wall/bump, filling real coverage gaps
         rather than trying to trace them exactly). This is a real, if
         approximate, extension -- not vertex-clustering fiction -- since
         cave_floor_patch's y-bounds were themselves derived from and
         validated against real floor vertices in this exact x-range. -->
    <!-- Y upper bound EXTENDED from 12 to 25 by real request, after live
         GUI teleport checks at (20,20) and (20,25) showed the vehicle
         visibly past the water plane's old edge. This plane is purely
         cosmetic -- the gz-sim-buoyancy-system plugin above gates on Z
         depth only, not X/Y region -- so this is a visual sync fix, not a
         physics change.

         Real request 2026-08-27: basin redesign lowered the surface
         7.9 -> 6.0 and widened the west edge 15 -> 5 (see entry_ramp/
         basin_floor above and boat_buoyancy_control.py's WATER_BOUNDARY_X,
         which this plane's own x-span must keep matching). x[5,70]
         size_x=65, center_x=37.5; y unchanged, [-12,25] size_y=37,
         center_y=6.5. -->
    <model name="water_surface">
      <static>true</static>
      <pose>37.5 6.5 6.0 0 0 0</pose>
      <link name="surface">
        <visual name="water_visual">
          <geometry><plane><size>65 37</size></plane></geometry>
          <material><diffuse>0.1 0.3 0.6 0.6</diffuse><ambient>0.1 0.3 0.6 0.6</ambient></material>
        </visual>
      </link>
    </model>

    <!-- North boundary wall, added alongside the y=25 water extension above:
         extending the water plane's own y-bound is purely cosmetic (see its
         comment -- buoyancy gates on Z only), so without a real collision
         object at that edge nothing physically stops the vehicle drifting
         past y=25 the way shoreline_ramp stops it at the x=15 edge. This is
         a straight (untilted) wall, not a ramp -- y=25 is deep water
         (z=7.9), not a wet/dry floor transition, so there is no floor
         height to meet. Tall enough to block the vehicle from cave_floor_
         patch height up through just above the water surface: z[5.9,8.9],
         size_z=3, center_z=7.4. Same friction/contact convention as its
         neighbors (max_vel=2.0, confirmed live to actually stop a
         thrust-driven approach -- see shoreline_ramp's own live wall-stop
         verification the same session).

         Real bug found live 2026-08-27: "vehicle tumbles / goes outside
         cave world" in water. Root cause traced to boat_buoyancy_control.py
         (the node that actually keeps the boat floating for this vehicle,
         since gz-sim-buoyancy-system is disabled for it -- see that
         plugin's own comment above): it gates lift purely on
         x > WATER_BOUNDARY_X (15.0), with NO upper x bound and NO y bound
         at all. So the vehicle stays buoyant (and controllable) far past
         this wall's original x[15,35] span and past cave_floor_patch's own
         y[-12,12] floor extent -- this single wall (originally sized to
         match the old cosmetic water_surface plane, x[15,35]) left every
         other edge of that real floating region completely open: drift
         past x=35 east, or past y=-12 south, and there is nothing to hit
         until the vehicle sails clean off the mapped world with no
         reference to recover orientation/position by (reads as "tumbles",
         since boat_buoyancy_control's righting torque has nothing wrong to
         correct -- the vehicle is still upright, just gone).

         Real request 2026-08-27: basin redesign widened water's west edge
         15 -> 5 and deepened the whole column 5.9-8.9 -> 3-6.5 (basin floor
         at z=3 up to just above the new z=6 surface) -- see entry_ramp/
         basin_floor above. x-span now [5,70] (size_x=65, center_x=37.5),
         z-span z[3,6.5] (size_z=3.5, center_z=4.75). West (x=5) still
         intentionally open -- entry_ramp now handles that edge. -->
    <model name="north_boundary_wall">
      <static>true</static>
      <pose>37.5 25 4.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>65 1 3.5</size></box></geometry>
          <surface>
            <contact><ode><max_vel>2.0</max_vel></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>65 1 3.5</size></box></geometry>
          <material><ambient>0.25 0.22 0.2 1</ambient><diffuse>0.25 0.22 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South boundary wall -- see north_boundary_wall's own comment for the
         full story (2026-08-27 tumble/out-of-bounds bug, then basin
         redesign). Mirrors it at cave_floor_patch's real south edge
         (y=-12) instead of y=25, same x[5,70]/z[3,6.5] span. -->
    <model name="south_boundary_wall">
      <static>true</static>
      <pose>37.5 -12 4.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>65 1 3.5</size></box></geometry>
          <surface>
            <contact><ode><max_vel>2.0</max_vel></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>65 1 3.5</size></box></geometry>
          <material><ambient>0.25 0.22 0.2 1</ambient><diffuse>0.25 0.22 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East boundary wall -- see north_boundary_wall's own comment for the
         full story (2026-08-27 tumble/out-of-bounds bug, then basin
         redesign). Closes the far (east) end of cave_floor_patch's own x
         extent (x=70), thin in x this time, spanning the full north/south
         box: y[-12,25] (size_y=37, center_y=6.5), z[3,6.5]. -->
    <model name="east_boundary_wall">
      <static>true</static>
      <pose>70 6.5 4.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 37 3.5</size></box></geometry>
          <surface>
            <contact><ode><max_vel>2.0</max_vel></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 37 3.5</size></box></geometry>
          <material><ambient>0.25 0.22 0.2 1</ambient><diffuse>0.25 0.22 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Dry-floor perimeter walls (cave_floor_patch_north_wall/south_wall,
         cave_floor_patch_scaled_north_wall/south_wall/west_wall) added
         earlier 2026-08-27 to contain the three dry-floor slabs, then
         ALL removed by a later real request the same day ("remove all
         cave floor walls"). The dry floor patches themselves
         (cave_floor_patch, cave_floor_patch_scaled, cave_floor_patch_bridge)
         and their ceilings above are unaffected -- only side containment
         is gone. Driving off any dry-floor edge now falls through to
         ground_plane's z=-200 safety net with nothing in between; the
         earlier bridge_east_wall/bridge_west_wall removal (see comment
         below) already established that as an accepted tradeoff for this
         region rather than a bug to re-fix. -->

    <!-- Real request 2026-08-27: cave_floor_patch_bridge_east_wall (x=-38)
         and cave_floor_patch_bridge_west_wall (x=-62) removed -- both were
         "lateral" walls (constant-x, running north-south across the
         corridor) standing directly in the vehicle's own east-west path
         from its spawn (-88.78, -31.4, inside cave_floor_patch_scaled) to
         the water region (x>=5): the corridor runs through
         cave_floor_patch_scaled -> cave_floor_patch_bridge ->
         cave_floor_patch -> water, and these two walls sat right across
         that route at y=-31.4 (bridge_east_wall's own y[-46,-12] span
         included it), blocking straight travel and forcing a detour north
         into y[-12,12] before either crossing.

         Known real gap this reopens: cave_floor_patch_bridge's own floor
         only covers y[-46,12] for x[-62,-38] -- east of x=-38 at y<-12,
         cave_floor_patch's floor doesn't extend that far south (its own
         y-range is [-12,12]). Removing the east wall there means a
         vehicle continuing straight through at y<-12 past x=-38 finds no
         floor at all until it either turns north into cave_floor_patch's
         real y-range or falls to ground_plane's z=-200 safety net -- same
         class of gap this file has documented and accepted before (e.g.
         entry_ramp's own x<15 void). Left open rather than papered over
         with more synthetic floor, since the real request was to remove
         the obstruction, not to guarantee every possible straight-line
         path. -->

    <!-- Ceilings, real request 2026-08-27 ("trim original cave world to
         cave floor patch and its vertical walls"): the walls above only
         close the SIDES of each walled region -- their own top edge (dry
         floor walls z=8.9, water walls z=6.5) was still wide open above,
         so the vehicle (or camera) could simply fly out over the top of
         any wall into the real cave_world mesh's own much taller, uneven
         open space. These are collision-only (no <visual> -- an opaque
         ceiling box would block every camera/RViz/web-viewer view looking
         down into the walled region, which defeats the purpose), one per
         walled footprint, bottom surface flush with its own walls' top
         edge (no gap): dry regions bottom=8.9 (center_z=9.4, thickness 1,
         same three patches' own x/y footprints as their floor/wall
         counterparts above -- overlap between them is harmless, same
         convention as the floors themselves), water region bottom=6.5
         (center_z=7.0, footprint matches water_surface/the water walls:
         x[5,70] y[-12,25]). -->
    <model name="cave_floor_patch_ceiling">
      <static>true</static>
      <pose>15 0 9.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>110 24 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="cave_floor_patch_scaled_ceiling">
      <static>true</static>
      <pose>-90 -31.4 9.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>60 29 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="cave_floor_patch_bridge_ceiling">
      <static>true</static>
      <pose>-50 -17 9.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24 58 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="water_ceiling">
      <static>true</static>
      <pose>37.5 6.5 7.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>65 37 1</size></box></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
