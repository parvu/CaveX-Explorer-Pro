<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="cavex_world">
    <physics name="4ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Ported from Gazebo Classic (gzserver/gazebo_ros) to Gazebo Harmonic
         (gz-sim). Adding any explicit <plugin> disables gz-sim's implicit
         default plugin set, so everything needed has to be listed here. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- Buoyancy plugin: vendored from clydemcqueen/bluerov2_gz's
         worlds/bluerov2_underwater.world (real upstream structure, not
         guessed -- the bluerov2 model.sdf itself has no Buoyancy plugin,
         only Hydrodynamics + 6 Thruster plugins; Buoyancy is a world-level
         plugin in the real upstream repo). above_depth is relative to
         world-frame z=0, so it's set to match the water_surface model's
         real pose below. Re-derived from a live probe-drop survey of the
         actual cave mesh (not the old, unverified whole-AABB-half guess --
         see water_surface's own comment for the full survey data): the real
         flooded chamber's floor sits at world z~=0, so above_depth=2.0 puts
         the water/air interface 2m above that floor (a partial fill, not a
         full-depth flood -- the chamber's ceiling is unobstructed to at
         least z=25, confirmed by probes falling completely unimpeded from
         z=25 all the way to the z~=0 floor). -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>2.0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <!-- Must match the SPAWN-TIME ENTITY NAME exactly, not just the model's internal
           SDF <model name>. gz-sim-buoyancy-system matches <enable> against the entity
           name given at spawn (e.g. the `name:` argument to `gz service .../create`),
           not the model file's own <model name="bluerov2">. Spawning with any other
           entity name (e.g. "bluerov2_test") makes Buoyancy silently no-op -- no error,
           the vehicle just sinks/rests on the floor as if unbuoyant. Confirmed the hard
           way: Task 16's own live verification test hit exactly this and produced a
           false pass (settled on ground_plane, not actual mid-water equilibrium) until
           re-run with the correctly-matching entity name "bluerov2". -->
      <enable>bluerov2</enable>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Real cave geometry: vendored from LTU-RAI/gazebo_cave_world (MIT).
         Koval, Kanellakis, Vidmark, Haluska, Nikolakopoulos, "A Subterranean
         Virtual Cave World for Gazebo based on the DARPA SubT Challenge",
         arXiv:2004.08452, Lulea University of Technology. Not authored here.
         Pose computed by Task 8's AABB script from the real OBJ vertices --
         NOT just a Z-axis yaw as originally planned: this OBJ's local up
         axis is Y, not Z (cross-checked against upstream's own
         worlds/cave_world.world, which itself applies roll=90 deg to stand
         the mesh up), so roll=pi/2 fixes local-Y-up -> world-Z-up and an
         additional yaw=pi/2 puts the ~150m long axis on world X.
         Real, measured world-frame bounds after this pose: x [-75.17,75.17],
         y [-51.16,51.16], z [0,36.18] (height is 36.18m, not the nominal
         33m -- >1m off nominal; x/y match nominal within ~0.2m).
         Dry section x [-70,0]; transition x [0,10]; water section x [10,70]. -->
    <include>
      <uri>model://cave_world</uri>
      <name>cave_world</name>
      <pose>18.7830 31.4050 5.9826 1.5708 0.0000 1.5708</pose>
    </include>

    <!-- Fuel-sourced obstacles for Nav2 costmap / explore_lite frontiers.
         Real, confirmed-to-exist OpenRobotics Fuel models. Note: Fuel's
         literal "rock"/"boulder"/"stone" search results (OpenRobotics'
         "*Rock Fall*"/"Falling Rock *" and Cole's "Ocean Rock *") are all
         <static>true</static> scripted terrain decoration -- verified live
         by downloading and grepping their model.sdf, and confirmed by a
         first live test run where 3 of 4 included as obstacle_1..4 sat
         frozen at their spawned z=8 instead of falling. Swapped for real,
         confirmed-dynamic (no <static> tag, real mass+inertia) OpenRobotics
         debris/prop models instead, so they actually fall and settle onto
         the real undulating cave floor mesh as the brief requires. Settled
         poses recorded in task-9-report.md. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Cinder%20Block%202</uri>
      <name>obstacle_1</name>
      <pose>-45 3 8 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Cinder%20block%20wide</uri>
      <name>obstacle_2</name>
      <pose>-32 -5 8 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Wood%20cube%2010cm</uri>
      <name>obstacle_3</name>
      <pose>-22 6 8 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Construction%20Barrel</uri>
      <name>obstacle_4</name>
      <pose>-12 -3 8 0 0 0</pose>
    </include>

    <!-- Flooded water region: re-derived from a LIVE probe-drop survey of
         the real cave mesh, not the earlier whole-AABB-half guess (a flat
         x [10,70] y [-45,45] rectangle at z=4.0, which the survey below
         shows was wrong -- e.g. a probe dropped at x=40,y=0 rested on solid
         rock at z=7.16, well ABOVE that old z=4.0 "water" surface, meaning
         much of the old rectangle floated over dry rock or empty space
         outside the mesh entirely, not a real flooded chamber).

         Survey method: 0.5m probe boxes dropped from z=25 (well above the
         cave mesh's tallest recorded point, z=36.18) across a grid, entity
         poses read back from `gz topic -t .../pose/info` once settled.
         Findings:
           - y=0 (the cave's nominal centerline) is frequently obstructed by
             rubble/ledges -- probes there settled at z=6-9 instead of the
             floor, or drifted several meters sideways off a slope.
           - y in [2,12], x in [15,65]: every probe (3 x-values x 10
             y-offsets, 30 points) settled at z~=0.20-0.25 (a 0.5m box's
             half-height resting on a floor at z~=0) with ZERO drift from
             its drop (x,y) -- a real, wide, flat, obstacle-free chamber
             floor at world z~=0, confirmed clear overhead for the full
             25m drop.
         Water surface placed at z=2.0 (Buoyancy plugin's above_depth,
         above): a 2m-deep partial flood of this chamber, well short of
         its real ~25m+ ceiling clearance -- a real lake within the cave,
         not a flood to the roof. Region inset slightly from the surveyed
         bounds for margin: x [17,63], y [3,11], center (40, 7, 2.0),
         plane size 46 x 8. Task 19's water-boundary handoff (not yet
         implemented) should use this chamber's real x=17 edge, not the
         old x=10 guess. -->
    <model name="water_surface">
      <static>true</static>
      <pose>40 7 2.0 0 0 0</pose>
      <link name="surface">
        <visual name="water_visual">
          <geometry><plane><size>46 8</size></plane></geometry>
          <material><diffuse>0.1 0.3 0.6 0.6</diffuse><ambient>0.1 0.3 0.6 0.6</ambient></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
