<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sic_slam</name>
  <version>0.1.0</version>
  <description>SIC-SLAM: acoustic-inertial factor-graph SLAM stack for UUV cave exploration (PED2026 prototype build)</description>
  <maintainer email="parvu@example.org">Parvu</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-gtsam</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- sim_launch.py resolves cavex_tracked_vehicle's share dir at runtime,
       to reuse its already-vendored bluerov2 meshes instead of duplicating
       them here. -->
  <exec_depend>cavex_tracked_vehicle</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
