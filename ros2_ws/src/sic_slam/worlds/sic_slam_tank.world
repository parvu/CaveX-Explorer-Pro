<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="sic_slam_tank">
    <physics name="4ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Explicit plugin list required: adding any <plugin> disables gz-sim's
         implicit default set, so everything needed must be listed here. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- IMU sensors are NOT handled by gz-sim-sensors-system above -- that
         one drives rendering-backed sensors (camera, gpu_lidar) via ogre2.
         IMU needs its own dedicated system, gz-sim-imu-system, which was
         missing entirely here (real bug, found 2026-08-25): bluerov2_sim's
         imu_sensor was declared in the SDF and showed up in gz-transport's
         topic registry (implying it existed), but had genuinely zero
         publishers -- no System instance was ever processing it. Confirmed
         by isolating from a red-herring WSL2/D3D12 GPU-driver crash
         investigated first: gpu_lidar (sonar) kept working fine throughout
         via the Sensors system above, proving this wasn't a GPU/rendering
         problem, just a missing plugin declaration. -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <!-- Hydrodynamics and Thruster are NOT declared here: unlike the
         world-required default systems above (Physics/UserCommands/
         SceneBroadcaster/Sensors), they were never part of gz-sim's implicit
         default set, so they don't need a bare world-level stanza to
         "enable" them -- bluerov2_sim/model.sdf already carries its own
         correctly-configured instances (link_name, joint_name, etc. per
         thruster). An earlier version of this file also declared them here,
         empty -- redundant AND broken (each empty declaration spawns its own
         separate, unconfigured System instance that spams "You must specify
         a <link_name>" / "Missing <joint_name>" every physics step and never
         actually does anything) -- confirmed against cavex_world.world
         (main branch), which declares neither at world level for the same
         reason. This is why the vehicle looked like it wasn't running: the
         underlying "no linear vel" spam is otherwise easy to miss among
         normal launch output. -->
    <!-- Buoyancy: the bluerov2_sim model has no Buoyancy plugin of its own
         (real upstream structure -- see model.sdf's collision-volume comment),
         it's a world-level plugin. Whole tank is flooded, so a single uniform
         density (no graded_buoyancy) is enough, unlike cavex_world.world's
         partial-flood cave. <enable> must match the spawn-time entity name
         ("bluerov2", see sim_launch.py's `create` node), not just the model's
         internal <model name> -- a mismatch silently no-ops (vehicle sinks to
         the floor as if unbuoyant, no error) -- see cavex_world.world's own
         Buoyancy comment for how that was found the hard way. -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <uniform_fluid_density>1000</uniform_fluid_density>
      <enable>bluerov2</enable>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="tank_floor">
      <static>true</static>
      <pose>0 0 -5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A simple two-wall "corridor" ahead of the spawn point, close enough
         (2 m gap) to guarantee the gpu_lidar-based sonar stand-in gets a
         non-infinite return to convert into an acoustic intensity row. -->
    <model name="wall_left">
      <static>true</static>
      <pose>5 1 -3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 0.3 4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 0.3 4</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_right">
      <static>true</static>
      <pose>5 -1 -3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 0.3 4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 0.3 4</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
