<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="sic_slam_cave_water">
    <!-- Pared-down GUI plugin set, ported verbatim from cavex_world.world
         (main branch) -- see that file's own comment for why: the gz-sim
         default GUI config crowds the window with floating toolbars
         (Shapes, Lights, TransformControl, EntityTree, etc.) nobody here
         uses. MinimalScene (3D view), GzSceneManager (required, syncs
         entities into the render scene), InteractiveViewControl (mouse
         zoom/rotate/pan/scroll -- unrelated to and unaffected by removing
         WorldControl below, they're independent plugins), CameraTracking
         (needed for /gui/follow), WorldStats (sim-time readout).
         WorldControl (the play/pause/step buttons) removed per real
         request -- the sim already starts unpaused (start_paused was
         already false), so nothing needed it running by default; this
         just means there's no in-GUI way to pause/step anymore. InfoLabel
         x2 (current speed, turbidity, now editable input fields, not just
         readouts) and ManualControl x2 (D-pad, depth+Manual) added on top
         -- see sim_info_publisher.py / their own comments below. -->
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <!-- Looking straight down at the water-center spawn (25, 0, 6.9),
             real request -- position directly above at z=20 (well above
             the water surface, z=7.9), pitch=pi/2 (nose-down) so the
             camera's forward axis points along -Z with no lateral offset,
             yaw=0 (arbitrary for a pure top-down view). -->
        <camera_pose>25 0 20 0 1.5708 0</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
      <!-- Current speed and turbidity, same line, bottom-left -- small
           transparent EDITABLE input fields (real request: not
           TopicEcho's scrollable debug console, which has no transparency/
           font-size/color/input controls -- see
           sic_slam_gui/src/InfoLabel.{hh,cc,qml}, a purpose-built minimal
           gz-gui plugin). Editing a field and pressing Enter publishes to
           <control_topic>, live, during the run -- see
           sim_info_publisher.py for what actually consumes each one. -->
      <plugin filename="InfoLabel" name="Current speed">
        <gz-gui>
          <!-- Real bug found and fixed previously: without an explicit
               <title> here, this plugin's registered title fell back to
               InfoLabel's own generic default ("Info"), so Turbidity's
               own `anchors target="Current speed"` below could never
               resolve to anything -- title strings are what gz-gui's
               anchor system actually matches against. -->
          <title>Current speed</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <!-- Explicit width/height, matching WorldStats'/WorldControl's
               own convention (both of which always worked) -- real
               hypothesis fix for the overlap/invisibility reports: this
               plugin never declared a card size before, relying purely on
               the inner QML Rectangle's own intrinsic sizing, but
               anchor-based floating-panel placement is done using the
               CARD's own stored width/height, not by measuring the QML
               content at runtime -- an unset size very plausibly explains
               both the wrong positioning and (for ManualControl below)
               two same-defaulted-size cards landing on top of each other. -->
          <property type="double" key="width">170</property>
          <property type="double" key="height">34</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <!-- Bottom-CENTER (real request), not bottom-left. -->
          <anchors target="3D View">
            <line own="horizontalCenter" target="horizontalCenter"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <topic>/sic_slam/current_speed_label</topic>
        <control_topic>/sic_slam/current_speed_set</control_topic>
        <label>Current speed</label>
        <unit>m/s</unit>
      </plugin>
      <!-- Same line as "Current speed" above (real request), not stacked
           below it -- anchored to its right edge. -->
      <plugin filename="InfoLabel" name="Turbidity">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">160</property>
          <property type="double" key="height">34</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="Current speed">
            <line own="left" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <topic>/sic_slam/turbidity_label</topic>
        <control_topic>/sic_slam/turbidity_set</control_topic>
        <label>Turbidity</label>
        <unit>dB/m</unit>
      </plugin>
      <!-- Manual drive, two instances of the same ManualControl plugin
           class (see <mode> below and ManualControl.qml) -- real request.
           Publishes to /sic_slam/manual_cmd; only actually moves the
           vehicle while manual_control_node.py (sic_slam/scripts, run
           separately -- same standalone-script convention as
           ate_circle_demo.py/corridor_walk_demo.py, not auto-launched) is
           running AND the Manual toggle is on. -->
      <!-- D-pad (left/fwd/right/rev + center stop) for XY -- top-left,
           the only free corner (bottom two are the InfoLabels + World
           control/stats). -->
      <plugin filename="ManualControl" name="Manual control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <!-- Explicit size -- see Current speed's own comment above for
               why (real hypothesis fix for the two ManualControl
               instances rendering "supraposed" on top of each other). -->
          <property type="double" key="width">150</property>
          <property type="double" key="height">96</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
        <mode>dpad</mode>
      </plugin>
      <!-- Depth (up/down) + the Manual toggle -- moved to top-right, per
           real request (previously part of the same top-left panel as
           the D-pad above). -->
      <plugin filename="ManualControl" name="Manual depth control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">100</property>
          <property type="double" key="height">96</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
        <mode>depth</mode>
      </plugin>
    </gui>
    <physics name="4ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Same explicit plugin list as sic_slam_tank.world -- see that file's
         own comments for why each one is required (in particular
         gz-sim-imu-system, missing from this project for its whole first
         session; see history_perception.md, "IMU sensor never publishing"). -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- Graded buoyancy, vendored verbatim from cavex_world.world (main
         branch): above_depth=7.9 matches this world's own water surface
         (CAVE_FLOOR_Z=5.9 + 2.0m partial flood, see cave_floor_patch/
         water_surface below, ported unchanged from that file's own
         real-mesh-derived values). <enable> must match the spawn-time
         entity name, not the model's internal <model name> -- see
         cavex_world.world's own Buoyancy comment for how a mismatch here
         silently no-ops (vehicle sinks as if unbuoyant, no error). -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>7.9</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <enable>bluerov2</enable>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Safety-net plane, far below all real geometry -- see
         cavex_world.world's own ground_plane comment: earlier versions of
         that file left this at z=0 and several "resting on the cave
         floor" checks turned out to actually be resting on this plane
         instead of real mesh collision. Kept far away here for the same
         reason. -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -200 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Real cave geometry, same vendored mesh + pose + 2x scale as
         cavex_world.world (main branch) -- resolved via model://cave_world
         against cavex_slam_nav's own models dir, added to
         GZ_SIM_RESOURCE_PATH by sim_launch.py rather than duplicating the
         ~17MB mesh+texture set into this package. Not re-derived here:
         pose/scale are copied verbatim from the main-branch world file
         that already validated them against the real OBJ vertices. -->
    <include>
      <uri>model://cave_world</uri>
      <name>cave_world</name>
      <pose>18.7830 31.4050 5.9826 1.5708 0.0000 1.5708</pose>
    </include>

    <!-- Supplementary floor collision under the water region only --
         cave_floor_patch from cavex_world.world, x[-40,70] y[-12,12]
         (this world only needs the water-covering slice of it; the
         cave_floor_patch_scaled/_bridge patches from that file cover the
         far dry-section corridor, which this water-only world has no use
         for). Same real-mesh-vertex-derived z=5.9 top surface. -->
    <model name="cave_floor_patch">
      <static>true</static>
      <pose>15 0 5.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>110 24 1</size></box></geometry>
          <surface>
            <contact><ode><max_vel>2.0</max_vel></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>110 24 1</size></box></geometry>
          <material><ambient>0.25 0.22 0.2 1</ambient><diffuse>0.25 0.22 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Shoreline ramp, vendored verbatim: blocks drift into the x<15
         dry-section boundary (entirely outside the water region's own
         x[15,35] navigable volume, per cavex_world.world's own live-tested
         placement). -->
    <model name="shoreline_ramp">
      <static>true</static>
      <pose>10.3481 6.5 6.2597 0 -0.1974 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.668 37 1</size></box></geometry>
          <surface>
            <contact><ode><max_vel>2.0</max_vel></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.668 37 1</size></box></geometry>
          <material><ambient>0.25 0.22 0.2 1</ambient><diffuse>0.25 0.22 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Cosmetic water surface plane, vendored verbatim -- purely visual,
         buoyancy gates on Z depth only (see plugin above), not this
         plane's own extent. -->
    <model name="water_surface">
      <static>true</static>
      <pose>25 6.5 7.9 0 0 0</pose>
      <link name="surface">
        <visual name="water_visual">
          <geometry><plane><size>20 37</size></plane></geometry>
          <!-- Alpha lowered 0.6 -> 0.25 (real request): more transparent,
               so the cave floor/vehicle stay visible through the surface
               from above instead of the water plane reading as opaque. -->
          <material><diffuse>0.1 0.3 0.6 0.25</diffuse><ambient>0.1 0.3 0.6 0.25</ambient></material>
        </visual>
      </link>
    </model>

    <!-- North boundary wall, vendored verbatim -- distant backstop only
         (y=25); the circle trajectory used for ATE runs here (see
         ate_circle_demo.py, radius=6 around center (25,0)) stays well
         inside the validated y[-12,12] floor coverage, so this wall is
         not expected to ever be reached, just kept as the same safety net
         main branch relies on. -->
    <model name="north_boundary_wall">
      <static>true</static>
      <pose>25 25 7.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 1 3</size></box></geometry>
          <surface>
            <contact><ode><max_vel>2.0</max_vel></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 1 3</size></box></geometry>
          <material><ambient>0.25 0.22 0.2 1</ambient><diffuse>0.25 0.22 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Real request: a surface support boat at Home (see
         sim_info_publisher.py's own Home marker -- same x/y, (25, 0)),
         at the water surface (z=7.9) rather than the ROV's own home
         depth (6.9) since a boat floats, it doesn't submerge. Reused
         unmodified from cavex_tracked_vehicle/models/blueboat (real
         Blue Robotics BlueBoat model, already on GZ_SIM_RESOURCE_PATH
         via sim_launch.py -- see that file's own comment for why
         cavex_tracked_vehicle's models dir is already on the path).
         <static>true</static> override: the model's own SDF has real
         revolute motor joints + thruster plugins (needs actual cmd_thrust
         commands to move, none are ever sent here), but it's NOT
         static by default -- "keep it stationary" (real request) means
         freezing it outright rather than relying on zero commands plus
         physics/gravity/buoyancy interactions never nudging it. -->
    <include>
      <uri>model://blueboat</uri>
      <name>blueboat</name>
      <pose>25 0 7.9 0 0 0</pose>
      <static>true</static>
    </include>
  </world>
</sdf>
